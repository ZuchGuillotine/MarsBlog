---
// Debris remediation — the SLP-5 laser payload proposed for the Shepherd-1 craft.
// Laser payload only: tracking and beam delivery are deliberately not described,
// and the parts-level materials list is not published.
import fs from 'node:fs';
import path from 'node:path';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SlpViewer from '../../components/debris/SlpViewer.astro';
import SlpSchematic from '../../components/debris/SlpSchematic.astro';
import { ORBITFLEET_URL, mailto } from '../../data/site';
import {
  glance,
  heroNumbers,
  kindLabel,
  steps,
  whyChoices,
  specGroups,
  energyLadder,
  survivability,
  stages,
  stageCost,
  costExclusions,
  openItems,
  references,
  FOUNDING_RATE,
  LATER_RATE,
  CONTINGENCY,
} from '../../data/debrisLaser';
import {
  attitudeCases,
  directionCases,
  massClasses,
  couplingCases,
  configs,
  timeline,
  nudge,
  shotsPerOrbit,
  formatDuration,
  formatShots,
  orbitalPeriodS,
  orbitalSpeedKmS,
  deorbitDeltaV,
  laser,
  DELIVERY_EFFICIENCY,
  DISPOSAL_PERIGEE_KM,
} from '../../lib/debrisLaserModel';

const posterPath = '/images/debris/slp5-poster.jpg';
const hasPoster = fs.existsSync(path.join(process.cwd(), 'public', posterPath));

const nav = [
  ['how', 'How it works'],
  ['schematic', 'Schematic'],
  ['specs', 'Specifications'],
  ['environment', 'Environment'],
  ['timelines', 'Timelines'],
  ['roadmap', 'Roadmap and cost'],
  ['open-items', 'Open items'],
];

// ---- timeline defaults (also the no-JavaScript view) -----------------------
const base = { altKm: 800, attitude: 0.6, offAxisDeg: 0, config: 'a' };
const AXIS_MIN = 3600; // 1 hour
const AXIS_MAX = 2000 * 365.25 * 86400; // 2,000 years
const pos = (s: number) =>
  Math.min(100, Math.max(0, ((Math.log10(s) - Math.log10(AXIS_MIN)) / (Math.log10(AXIS_MAX) - Math.log10(AXIS_MIN))) * 100));
const YEAR = 365.25 * 86400;
const ticks = [
  { s: 3600, label: '1 hour' },
  { s: 86400, label: '1 day' },
  { s: 30.44 * 86400, label: '1 month' },
  { s: YEAR, label: '1 year' },
  { s: 10 * YEAR, label: '10 years' },
  { s: 100 * YEAR, label: '100 years' },
  { s: 1000 * YEAR, label: '1,000 yr' },
];
const MID = couplingCases[1].value;
const rows = massClasses.map(m => {
  const at = (cm: number) => timeline({ massKg: m.kg, cm, ...base });
  return { ...m, mid: at(MID), fast: at(couplingCases[2].value), slow: at(couplingCases[0].value) };
});
const nudgeMasses = [
  { kg: 100, label: '100 kg satellite' },
  { kg: 1000, label: '1 t satellite' },
  { kg: 9000, label: '9 t rocket stage' },
];
const nudges = nudgeMasses.map(m => ({ ...m, ...nudge({ massKg: m.kg, cm: MID, ...base }, 0.01) }));
const altitudeTable = [500, 600, 700, 800, 1000, 1200].map(h => ({
  h,
  v: orbitalSpeedKmS(h),
  dv: deorbitDeltaV(h),
  period: orbitalPeriodS(h) / 60,
}));
const baseline = timeline({ massKg: 1, cm: MID, ...base });

// One laser life, at the default factors.
const lifeImpulse = baseline.impulsePerShot * laser.designLifeShots;
const lifeMassKg = lifeImpulse / baseline.deltaV;
const lifeNudges = lifeImpulse / (1000 * 0.01);
const shotsFor100kg = timeline({ massKg: 100, cm: MID, ...base }).shots;

// Same laser, more power: each firing pattern at the default factors.
const growth = configs.map(c => {
  const t = (kg: number) => timeline({ massKg: kg, cm: MID, ...base, config: c.id });
  return {
    c,
    shotsPerYear: (shotsPerOrbit(c.id, base.altKm) * YEAR) / orbitalPeriodS(base.altKm),
    kg10: formatDuration(t(10).seconds),
    kg100: formatDuration(t(100).seconds),
    t1: formatDuration(t(1000).seconds),
  };
});
// Calendar life has to count whole orbits, not firing seconds.
const calendarLife = (id: string) =>
  (laser.designLifeShots / shotsPerOrbit(id, base.altKm)) * orbitalPeriodS(base.altKm);

// ---- cost ------------------------------------------------------------------
const costs = stages.map(s => ({ s, c: stageCost(s) }));
const sum = (list: typeof costs) =>
  list.reduce(
    (t, { c }) => ({
      labour: t.labour + c.labour,
      hardware: t.hardware + c.hardware,
      test: t.test + c.test,
      total: t.total + c.total,
    }),
    { labour: 0, hardware: 0, test: 0, total: 0 }
  );
const totals = sum(costs);
const seed = sum(costs.filter(x => x.s.seed));
const engineerYears = stages.reduce((t, s) => t + s.engineers * (s.months / 12), 0);
const totalMonths = stages.filter(s => s.engineers > 0).reduce((t, s) => t + s.months, 0);
const maxStage = Math.max(...costs.map(x => x.c.total));
const usd = (n: number) => (n < 5e5 ? `$${(n / 1e6).toFixed(2)}M` : `$${(n / 1e6).toFixed(1)}M`);
const pct = (n: number) => `${((n / maxStage) * 100).toFixed(2)}%`;
const flightTeam = stages[stages.length - 1];

const refIndex = Object.fromEntries(references.map((r, i) => [r.id, i + 1]));
const cite = (...ids: string[]) => ids.map(id => refIndex[id]).filter(Boolean).join(', ');

const modelConfig = { axisMin: AXIS_MIN, axisMax: AXIS_MAX, lifeShots: laser.designLifeShots };
---

<BaseLayout
  title="SLP-5 Debris Remediation Laser | Population Mars"
  description="A proposed 5-joule, 355 nm pulsed ultraviolet laser payload for removing orbital debris by ablation: how it works, the full schematic, de-orbit timelines by mass and altitude, and a staged cost estimate."
  ogImage={hasPoster ? posterPath : undefined}
>
  <div class="slp">
    <!-- ================= HERO ================= -->
    <header class="hero shell">
      <div class="crumbs">
        <span>Our projects</span><span aria-hidden="true">/</span><span>Debris remediation</span>
      </div>
      <div class="hero-grid">
        <div class="hero-copy">
          <p class="eyebrow">Population Mars · orbital debris remediation</p>
          <h1>The SLP-5 debris laser</h1>
          <p class="thesis">
            A proposed 5-joule ultraviolet laser payload for the Shepherd-1 craft. Each pulse
            vaporises a few micrograms off a piece of debris, and the recoil changes its speed. A
            few days of pulses move a dead satellite off a collision course. A few weeks of them
            bring a fragment down.
          </p>
          <p class="status-line">
            <span class="dot" aria-hidden="true"></span><strong>Stage:</strong> concept design.
            Nothing is built, and every figure here is a design target or a calculation.
          </p>
          <div class="actions">
            <a class="button primary" href="#timelines">Timelines <span aria-hidden="true">↓</span></a>
            <a class="button" href="#schematic">Schematic <span aria-hidden="true">↓</span></a>
            <a class="button ghost" href={`${ORBITFLEET_URL}/debris`} rel="noopener">
              Debris simulation <span aria-hidden="true">↗</span>
            </a>
          </div>
        </div>
        <aside class="glance" aria-labelledby="glance-title">
          <h2 id="glance-title" class="eyebrow">At a glance</h2>
          <dl>
            {
              glance.map(g => (
                <div>
                  <dt>{g.k}</dt>
                  <dd>{g.v}</dd>
                </div>
              ))
            }
          </dl>
        </aside>
      </div>

      <div class="viewer-wrap">
        <SlpViewer poster={hasPoster ? posterPath : undefined} />
      </div>

      <ul class="numbers" aria-label="Key numbers">
        {
          heroNumbers.map(n => (
            <li>
              <span class="num">{n.value}</span>
              <span class="num-label">{n.label}</span>
              <span class="kind">{kindLabel[n.kind]}</span>
            </li>
          ))
        }
      </ul>
    </header>

    <!-- ================= STICKY NAV ================= -->
    <nav class="section-nav" aria-label="Page sections">
      <div class="shell nav-inner">
        <div class="nav-links">
          {nav.map(([id, label]) => <a href={`#${id}`}>{label}</a>)}
        </div>
      </div>
    </nav>

    <!-- ================= 01 HOW IT WORKS ================= -->
    <section class="shell section" id="how" aria-labelledby="how-title">
      <p class="eyebrow">01 · How it works</p>
      <h2 id="how-title">Push debris with its own vapour.</h2>
      <p class="intro">
        A short, intense pulse of light turns a thin layer of a surface into plasma. The plasma
        leaves at kilometres per second, and the object recoils the other way. Nothing touches the
        debris and nothing has to grab it. Fired against the direction of travel, each pulse takes
        a little speed off, and a slower object drops to a lower orbit
        <sup class="ref"><a href="#ref-phipps2012">[{refIndex.phipps2012}]</a></sup>.
      </p>
      <p class="intro">
        The laser itself is a chain: a small, very clean pulse is amplified a thousand-fold in
        infrared, then converted to ultraviolet.
      </p>
      <ol class="steps">
        {
          steps.map(s => (
            <li>
              <span class="step-n">{s.n}</span>
              <h3>{s.title}</h3>
              <p>{s.body}</p>
              <p class="step-stat">{s.stat}</p>
            </li>
          ))
        }
      </ol>

      <div class="orbit-cycle" role="img" aria-label="One orbit: a 300 second burst followed by 93 minutes of recovery">
        <div class="cycle-head">
          <span>One orbit, to scale</span>
          <span>98 minutes</span>
        </div>
        <div class="cycle-bar">
          <span class="cycle-fire"></span>
          <span class="cycle-rest"></span>
        </div>
        <div class="cycle-legend">
          <span><i class="fire"></i>Burst: 300 s, 3,000 shots, 600 W drawn from the buffer</span>
          <span><i class="rest"></i>Recovery: 93 min, wax refreezes, buffer recharges at 43 W</span>
        </div>
      </div>

      <div class="why-grid">
        {
          whyChoices.map(w => (
            <article>
              <h3>{w.title}</h3>
              <p>{w.body}</p>
            </article>
          ))
        }
      </div>
    </section>

    <!-- ================= 02 SCHEMATIC ================= -->
    <section class="band section" id="schematic" aria-labelledby="schem-h">
      <div class="shell">
        <p class="eyebrow">02 · System schematic</p>
        <h2 id="schem-h">Two decks: light above, power and heat below.</h2>
        <p class="intro">
          The optical train is folded onto one silicon carbide bench inside a sealed cavity. Power
          electronics, the energy buffer and the thermal capacitor sit underneath, coupled to the
          bench by conduction.
        </p>
        <SlpSchematic />

        <h3 class="table-title">Pulse energy through the chain</h3>
        <div class="table-wrap">
          <table class="data-table">
            <thead>
              <tr>
                <th scope="col">Stage</th>
                <th scope="col">Pulse energy</th>
                <th scope="col">Wavelength</th>
                <th scope="col">Beam</th>
              </tr>
            </thead>
            <tbody>
              {
                energyLadder.map(e => (
                  <tr>
                    <th scope="row">{e.stage}</th>
                    <td class="mono">{e.energy}</td>
                    <td class="mono">{e.wavelength}</td>
                    <td>{e.beam}</td>
                  </tr>
                ))
              }
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <!-- ================= 03 SPECIFICATIONS ================= -->
    <section class="shell section" id="specs" aria-labelledby="specs-title">
      <p class="eyebrow">03 · Specifications</p>
      <h2 id="specs-title">Design targets.</h2>
      <p class="intro">
        These are the numbers the design is built to. None has been measured. Where a target is
        aggressive, it is listed again under <a href="#open-items">open items</a>.
      </p>
      <div class="spec-grid">
        {
          specGroups.map(g => (
            <section class="spec-group" aria-label={g.title}>
              <h3>{g.title}</h3>
              <dl>
                {g.rows.map(([k, v, note]) => (
                  <div>
                    <dt>{k}</dt>
                    <dd>
                      <span class="spec-v">{v}</span>
                      {note && <span class="spec-note">{note}</span>}
                    </dd>
                  </div>
                ))}
              </dl>
            </section>
          ))
        }
      </div>
    </section>

    <!-- ================= 04 ENVIRONMENT ================= -->
    <section class="band section" id="environment" aria-labelledby="env-title">
      <div class="shell">
        <p class="eyebrow">04 · Surviving the environment</p>
        <h2 id="env-title">Four ways orbit kills an ultraviolet laser.</h2>
        <p class="intro">
          Space lidar missions have shown that the laser physics is the easier part. Keeping
          ultraviolet optics alive in vacuum for years is the harder one
          <sup class="ref"
            ><a href="#ref-lux2024">[{refIndex.lux2024}]</a><a href="#ref-esaaeolus">[{refIndex.esaaeolus}]</a><a
              href="#ref-riede">[{refIndex.riede}]</a
            ></sup
          >.
        </p>
        <ol class="pushback">
          {
            survivability.map(p => (
              <li>
                <span class="pb-n">{p.n}</span>
                <div class="pb-body">
                  <h3>{p.problem}</h3>
                  <p class="pb-num">{p.numbers}</p>
                  <p class="pb-resp">
                    <strong>Response.</strong>
                    {p.response}
                  </p>
                </div>
              </li>
            ))
          }
        </ol>
        <p class="src-line">
          Sources: Aeolus oxygen purge [{cite('lux2024', 'esaaeolus')}]; coatings in vacuum [{cite('riede')}]; 885
          nm absorption band [{cite('lavi2000')}]; wax properties [{cite('faden2019')}].
        </p>
      </div>
    </section>

    <!-- ================= 05 TIMELINES ================= -->
    <section class="shell section" id="timelines" aria-labelledby="tl-title">
      <p class="eyebrow">05 · Nudge and de-orbit timelines</p>
      <h2 id="tl-title">Days to nudge a derelict. Weeks to bring down a fragment.</h2>
      <p class="intro">
        The craft flies in close formation with one object at a time, ahead of it on the same
        orbit, and fires back along the track. That gives it two jobs. A nudge changes an
        object’s speed by about a centimetre per second, enough to turn a predicted collision
        into a miss. A de-orbit takes off a hundred metres per second or more, until the
        atmosphere finishes the work.
      </p>
      <p class="intro">
        Both are a momentum budget: mass times the change in speed, divided by the impulse each
        pulse delivers. Altitude sets the speed to be lost. The direction of the push and how the
        object is turning set how much of each pulse counts. The firing pattern sets how fast the
        pulses come.
      </p>

      <div class="calc" data-calc data-config={JSON.stringify(modelConfig)}>
        <form class="calc-controls" aria-label="Timeline inputs">
          <label class="ctl">
            <span class="ctl-label">Altitude (circular orbit)</span>
            <span class="ctl-row">
              <input type="range" min="500" max="1200" step="50" value={base.altKm} data-alt aria-describedby="alt-out" />
              <output id="alt-out" data-alt-out>{base.altKm} km</output>
            </span>
          </label>
          <fieldset class="ctl">
            <legend class="ctl-label">Firing pattern (same laser)</legend>
            <div class="seg">
              {
                configs.map(c => (
                  <label>
                    <input type="radio" name="config" value={c.id} checked={c.id === base.config} />
                    <span>{c.label}</span>
                  </label>
                ))
              }
            </div>
          </fieldset>
          <fieldset class="ctl">
            <legend class="ctl-label">Attitude of the debris</legend>
            <div class="seg">
              {
                attitudeCases.map(a => (
                  <label>
                    <input type="radio" name="attitude" value={a.factor} checked={a.factor === base.attitude} />
                    <span>{a.label}</span>
                  </label>
                ))
              }
            </div>
          </fieldset>
          <fieldset class="ctl">
            <legend class="ctl-label">Push direction against velocity</legend>
            <div class="seg">
              {
                directionCases.map(d => (
                  <label>
                    <input type="radio" name="direction" value={d.deg} checked={d.deg === base.offAxisDeg} />
                    <span>{d.label}</span>
                  </label>
                ))
              }
            </div>
          </fieldset>
        </form>

        <dl class="calc-stats">
          <div>
            <dt>Orbital speed</dt>
            <dd data-stat-v>{orbitalSpeedKmS(base.altKm).toFixed(2)} km/s</dd>
          </div>
          <div>
            <dt>Speed to lose for a de-orbit</dt>
            <dd data-stat-dv>{Math.round(baseline.deltaV)} m/s</dd>
          </div>
          <div>
            <dt>Shots per orbit</dt>
            <dd data-stat-n>{Math.round(shotsPerOrbit(base.config, base.altKm)).toLocaleString('en-US')}</dd>
          </div>
          <div>
            <dt>Impulse per orbit</dt>
            <dd data-stat-j>{baseline.impulsePerOrbit.toFixed(2)} N·s</dd>
          </div>
        </dl>

        <div class="nudge">
          <div>
            <h3>Nudge: 1 cm/s to avoid a collision</h3>
            <p>
              Two dead objects cannot dodge each other. A change of about a centimetre per second,
              applied a day or more before a predicted close approach, moves the pass by
              kilometres. This is the job the laser does well from its first flight, on objects
              far too large for it to bring down.
            </p>
          </div>
          <table class="data-table nudge-table">
            <thead>
              <tr>
                <th scope="col">Object</th>
                <th scope="col">Shots</th>
                <th scope="col">Elapsed time</th>
              </tr>
            </thead>
            <tbody>
              {
                nudges.map(n => (
                  <tr data-nudge data-mass={n.kg}>
                    <th scope="row">{n.label}</th>
                    <td class="mono" data-nudge-b>{n.shots.toLocaleString('en-US')}</td>
                    <td class="mono" data-nudge-t>{formatDuration(n.seconds)}</td>
                  </tr>
                ))
              }
            </tbody>
          </table>
        </div>

        <div class="tl-chart">
          <p class="tl-title">
            De-orbit: time to lower perigee to {DISPOSAL_PERIGEE_KM} km
            <span>Dot: 50 µN·s/J. Bar: 100 down to 25 µN·s/J.</span>
          </p>
          <div class="tl-rows" role="table" aria-label="Time to de-orbit by debris mass">
            <div class="tl-axis" aria-hidden="true">
              <span class="tl-axis-pad"></span>
              <span class="tl-track">
                {ticks.map(t => <i class="tick" style={`left:${pos(t.s)}%`}><b>{t.label}</b></i>)}
                <i class="life" data-life style={`left:${pos(calendarLife(base.config))}%`}><b>10⁸-shot design life</b></i>
              </span>
              <span class="tl-axis-pad end"></span>
            </div>
            {
              rows.map(r => (
                <div class="tl-row" role="row" data-row data-mass={r.kg} tabindex="0">
                  <span class="tl-mass" role="rowheader">
                    <strong>{r.label}</strong>
                    <small>{r.example}</small>
                  </span>
                  <span class="tl-track" role="presentation">
                    {ticks.map(t => <i class="grid" style={`left:${pos(t.s)}%`} />)}
                    <i class="life-line" data-life style={`left:${pos(calendarLife(base.config))}%`} />
                    <i
                      class="range"
                      data-range
                      style={`left:${pos(r.fast.seconds)}%;width:${Math.max(0.6, pos(r.slow.seconds) - pos(r.fast.seconds))}%`}
                    />
                    <i class="dot" data-dot style={`left:${pos(r.mid.seconds)}%`} />
                  </span>
                  <span class="tl-value" role="cell" data-value>{formatDuration(r.mid.seconds)}</span>
                  <span class="tl-detail" role="cell" data-detail>
                    {formatShots(r.mid.shots)} · {formatDuration(r.fast.seconds)} to {formatDuration(r.slow.seconds)}
                  </span>
                </div>
              ))
            }
          </div>
        </div>
      </div>

      <h3 class="table-title" id="growth">Same laser, more power</h3>
      <p class="sub-intro">
        The laser head does not change between these rows. What changes is how long and how fast
        it fires, which is set by the power and radiator area the host spacecraft can give it.
        Times are for 800 km, a slowly tumbling object and 50 µN·s/J.
      </p>
      <div class="table-wrap">
        <table class="data-table growth-table">
          <thead>
            <tr>
              <th scope="col">Firing pattern</th>
              <th scope="col">Host</th>
              <th scope="col">Bus power</th>
              <th scope="col">Radiator</th>
              <th scope="col">10 kg down</th>
              <th scope="col">100 kg down</th>
              <th scope="col">1 t down</th>
              <th scope="col">10⁸ shots last</th>
            </tr>
          </thead>
          <tbody>
            {
              growth.map(g => (
                <tr>
                  <th scope="row">{g.c.label}</th>
                  <td data-label="Host">{g.c.host}</td>
                  <td class="mono" data-label="Bus power">{g.c.bus}</td>
                  <td class="mono" data-label="Radiator">{g.c.radiator}</td>
                  <td class="mono" data-label="10 kg down">{g.kg10}</td>
                  <td class="mono" data-label="100 kg down">{g.kg100}</td>
                  <td class="mono" data-label="1 t down">{g.t1}</td>
                  <td class="mono" data-label="10⁸ shots last">{formatDuration(calendarLife(g.c.id))}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
      <p class="src-line">
        Bus power and radiator ranges run from the 8.3% efficiency target to 6%. Firing all the way
        round the orbit lowers it about half as efficiently as firing at one point, which is
        included.
      </p>

      <div class="reading">
        <article>
          <h3>What the first flight does</h3>
          <p>
            Firing for 5% of each orbit, the laser brings a 1 kg fragment down from 800 km in
            about five weeks and a 10 kg object in about a year. It nudges a one-tonne derelict by
            1 cm/s in about two days. It does not bring down dead satellites: at this firing rate
            a 100 kg object would take ten years.
          </p>
        </article>
        <article>
          <h3>One laser life</h3>
          <p>
            The head is designed for 10⁸ shots. At these factors that is about {
              (Math.round(lifeImpulse / 100) * 100).toLocaleString('en-US')
            } N·s of useful impulse: about {Math.round(lifeMassKg)} kg brought down from 800 km, or
            about {(Math.round(lifeNudges / 100) * 100).toLocaleString('en-US')} nudges of a one-tonne object. A 100 kg
            satellite costs {(shotsFor100kg / 1e8).toFixed(1)} × 10⁸ shots however fast they are
            fired. So the larger configurations depend on raising shot life toward 10⁹ as much as
            on power.
          </p>
        </article>
        <article>
          <h3>Velocity and direction</h3>
          <p>
            Only the part of the push that opposes the velocity lowers the orbit, so the craft
            works from ahead of its target, flying the same orbit at nearly the same speed. A push
            from the side does a quarter as much per unit of impulse, and a push from behind
            raises the orbit, which is what a collision-avoidance nudge sometimes wants.
          </p>
        </article>
        <article>
          <h3>Attitude</h3>
          <p>
            Recoil acts along the surface normal, not along the beam. A flat face square to the
            beam uses nearly all of each pulse. A tumbling plate averages well below that, and
            off-centre hits change its spin. The attitude factors here are assumptions until
            someone measures them on real debris.
          </p>
        </article>
      </div>

      <details class="math">
        <summary>How these numbers are calculated</summary>
        <div class="math-body">
          <dl>
            <div>
              <dt>Energy per shot</dt>
              <dd>
                {laser.pulseEnergyJ} J emitted; {DELIVERY_EFFICIENCY * 100}% assumed to land on the target at a
                coupling fluence
              </dd>
            </div>
            <div>
              <dt>Coupling coefficient</dt>
              <dd>50 µN·s per joule, shown with 25 and 100. Published values for nanosecond pulses span this range and beyond [{cite('phipps2012', 'ladroit', 'odc2023')}]. V0 measures it</dd>
            </div>
            <div>
              <dt>Attitude factor</dt>
              <dd>{attitudeCases.map(a => `${a.factor} ${a.label.toLowerCase()}`).join('; ')}</dd>
            </div>
            <div>
              <dt>Direction factor</dt>
              <dd>Cosine of the angle between the push and the anti-velocity direction</dd>
            </div>
            <div>
              <dt>Firing arc</dt>
              <dd>A push applied an angle θ round the orbit from the ideal point counts (1 + cos θ) ÷ 2, so continuous firing is half as efficient as a short burst</dd>
            </div>
            <div>
              <dt>Speed to lose</dt>
              <dd>The single retrograde impulse that drops the far side of a circular orbit to {DISPOSAL_PERIGEE_KM} km</dd>
            </div>
            <div>
              <dt>After that</dt>
              <dd>Drag at a {DISPOSAL_PERIGEE_KM} km perigee finishes the descent in weeks to months, depending on the object’s area-to-mass ratio and on solar activity. Not included in the times shown</dd>
            </div>
          </dl>
          <p class="math-result">
            time = mass × Δv ÷ (shots per orbit × {laser.pulseEnergyJ} J × {DELIVERY_EFFICIENCY} × C<sub>m</sub> × attitude × cos θ × arc factor) × orbital period
          </p>
          <div class="table-wrap">
            <table class="data-table alt-table">
              <thead>
                <tr>
                  <th scope="col">Altitude</th>
                  <th scope="col">Orbital speed</th>
                  <th scope="col">Period</th>
                  <th scope="col">Speed to lose</th>
                </tr>
              </thead>
              <tbody>
                {
                  altitudeTable.map(a => (
                    <tr>
                      <th scope="row">{a.h.toLocaleString('en-US')} km</th>
