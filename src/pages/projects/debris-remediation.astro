    margin-top: auto;
  }

  /* ---------- sticky nav ---------- */
  .section-nav {
    position: sticky;
    top: 64px;
    z-index: 30;
    background: rgba(11, 13, 18, 0.96);
    backdrop-filter: blur(6px);
    border-block: 1px solid var(--line);
  }
  .nav-links {
    display: flex;
    gap: 22px;
    overflow-x: auto;
    scrollbar-width: none;
  }
  .nav-links::-webkit-scrollbar {
    display: none;
  }
  .nav-links a {
    white-space: nowrap;
    text-decoration: none;
    font-size: 11px;
    letter-spacing: 0.04em;
    padding: 15px 0;
    color: #c0c6d4;
  }
  .nav-links a:hover {
    color: var(--accent);
  }

  /* ---------- how it works ---------- */
  .steps {
    list-style: none;
    padding: 0;
    margin-top: 36px !important;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
  }
  .steps li {
    border: 1px solid var(--line-strong);
    background: var(--band);
    padding: 22px;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .step-n {
    font-size: 12px;
    color: var(--accent);
  }
  .steps p {
    font-size: 14px;
    color: var(--soft);
  }
  .steps .step-stat {
    margin-top: auto !important;
    padding-top: 12px;
    border-top: 1px solid var(--line);
    font-size: 11px;
    color: var(--ink);
    line-height: 1.55;
  }
  .orbit-cycle {
    margin-top: 28px;
    border: 1px solid var(--line-strong);
    padding: 20px 22px;
  }
  .cycle-head {
    display: flex;
    justify-content: space-between;
    font:
      11px 'JetBrains Mono',
      monospace;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .cycle-bar {
    display: flex;
    gap: 2px;
    height: 18px;
    margin-top: 12px;
  }
  .cycle-fire {
    flex: 0 0 5.1%;
    background: #9085e9;
    border-radius: 2px 0 0 2px;
  }
  .cycle-rest {
    flex: 1;
    background: #262c3a;
    border-radius: 0 2px 2px 0;
  }
  .cycle-legend {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 28px;
    margin-top: 12px;
    font-size: 13px;
    color: var(--soft);
  }
  .cycle-legend span {
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .cycle-legend i {
    width: 12px;
    height: 12px;
    border-radius: 2px;
    flex: none;
  }
  .cycle-legend .fire {
    background: #9085e9;
  }
  .cycle-legend .rest {
    background: #262c3a;
    border: 1px solid #4a5266;
  }
  .why-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 32px;
    margin-top: 44px;
  }
  .why-grid article {
    border-top: 2px solid #4b3f86;
    padding-top: 16px;
  }
  .why-grid h3 {
    font-size: 18px;
    margin-bottom: 8px;
  }
  .why-grid p {
    font-size: 14px;
    color: var(--soft);
  }

  /* ---------- tables ---------- */
  .table-title {
    margin-top: 48px;
    margin-bottom: 8px;
  }
  .table-wrap {
    overflow-x: auto;
  }
  .data-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 14px;
  }
  .data-table th,
  .data-table td {
    text-align: left;
    vertical-align: top;
    padding: 12px 14px;
    border-bottom: 1px solid var(--line);
  }
  .data-table thead th {
    font-size: 10px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
    font-weight: 500;
    border-bottom: 1px solid #55607a;
  }
  .data-table tbody th,
  .data-table tfoot th {
    font-weight: 600;
    color: var(--ink);
  }
  .data-table td {
    color: var(--soft);
  }
  .data-table td.strong {
    color: var(--ink);
    font-weight: 600;
  }
  .data-table tfoot th,
  .data-table tfoot td {
    border-top: 1px solid #55607a;
    border-bottom: 0;
  }
  .data-table tfoot tr + tr :is(th, td) {
    border-top: 1px solid var(--line);
  }

  /* ---------- specs ---------- */
  .spec-grid {
    margin-top: 36px;
    columns: 2;
    column-gap: 40px;
  }
  .spec-group {
    break-inside: avoid;
    margin-bottom: 28px;
  }
  .spec-group h3 {
    font:
      600 12px 'JetBrains Mono',
      monospace;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--accent);
    padding-bottom: 10px;
    border-bottom: 1px solid #55607a;
  }
  .spec-group dl div {
    display: grid;
    grid-template-columns: minmax(150px, 38%) 1fr;
    gap: 16px;
    padding: 10px 0;
    border-bottom: 1px solid var(--line);
  }
  .spec-group dt {
    font-size: 11px;
    letter-spacing: 0.04em;
    color: var(--muted);
    padding-top: 3px;
  }
  .spec-v {
    display: block;
    font-size: 15px;
    color: var(--ink);
  }
  .spec-note {
    display: block;
    font-size: 13px;
    color: var(--muted);
  }

  /* ---------- environment ---------- */
  .pushback {
    list-style: none;
    padding: 0;
    margin-top: 32px !important;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
  }
  .pushback li {
    display: flex;
    gap: 18px;
    border: 1px solid var(--line-strong);
    background: var(--bg);
    padding: 24px;
  }
  .pb-n {
    font-size: 12px;
    color: var(--accent);
    padding-top: 3px;
  }
  .pb-body h3 {
    margin-bottom: 12px;
  }
  .pb-num {
    font-size: 14px;
    color: var(--soft);
  }
  .pb-resp {
    margin-top: 12px !important;
    font-size: 14px;
    color: var(--ink);
    padding-top: 12px;
    border-top: 1px solid var(--line);
  }
  .pb-resp strong {
    color: var(--accent);
    font-weight: 600;
  }

  /* ---------- timelines ---------- */
  .calc {
    margin-top: 36px;
    border: 1px solid var(--line-strong);
    background: var(--band);
  }
  .calc-controls {
    display: grid;
    grid-template-columns: 1fr 1.25fr 1.25fr;
    gap: 24px;
    padding: 22px 24px;
    border-bottom: 1px solid var(--line);
  }
  .ctl {
    border: 0;
    padding: 0;
    margin: 0;
    min-width: 0;
    display: block;
  }
  .ctl-label {
    display: block;
    font-size: 10px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
    margin-bottom: 10px;
    padding: 0;
  }
  .ctl-row {
    display: flex;
    align-items: center;
    gap: 14px;
  }
  .ctl-row input[type='range'] {
    flex: 1;
    min-width: 0;
    accent-color: #9085e9;
    height: 28px;
  }
  .ctl-row output {
    font:
      600 15px 'JetBrains Mono',
      monospace;
    min-width: 78px;
    text-align: right;
  }
  .seg {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .seg label {
    display: flex;
    align-items: center;
    gap: 9px;
    font-size: 13.5px;
    color: var(--soft);
    cursor: pointer;
  }
  .seg input {
    accent-color: #9085e9;
    width: 15px;
    height: 15px;
    margin: 0;
    flex: none;
  }
  .seg label:has(input:checked) {
    color: var(--ink);
  }
  .calc-stats {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    border-bottom: 1px solid var(--line);
  }
  .calc-stats div {
    padding: 16px 24px;
    border-right: 1px solid var(--line);
  }
  .calc-stats div:last-child {
    border-right: 0;
  }
  .calc-stats dt {
    font-size: 10px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .calc-stats dd {
    font-size: 24px;
    letter-spacing: -0.02em;
    margin-top: 4px;
    font-variant-numeric: tabular-nums;
  }
  .tl-chart {
    padding: 22px 24px 18px;
  }
  .tl-title {
    font-size: 15px;
    font-weight: 600;
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 4px 20px;
  }
  .tl-title span {
    font:
      400 11px 'JetBrains Mono',
      monospace;
    color: var(--muted);
  }
  .tl-rows {
    margin-top: 14px;
    --label-w: 210px;
    --value-w: 104px;
  }
  .tl-axis,
  .tl-row {
    display: grid;
    grid-template-columns: var(--label-w) 1fr var(--value-w);
    column-gap: 16px;
    align-items: center;
  }
  .tl-axis {
    height: 44px;
    align-items: stretch;
  }
  .tl-track {
    position: relative;
    display: block;
    height: 100%;
    min-height: 40px;
  }
  .tl-axis .tick,
  .tl-axis .life {
    position: absolute;
    bottom: 0;
    height: 6px;
    width: 1px;
    background: #55607a;
  }
  .tl-axis .tick b,
  .tl-axis .life b {
    position: absolute;
    bottom: 10px;
    left: 0;
    transform: translateX(-50%);
    white-space: nowrap;
    font:
      400 10.5px 'JetBrains Mono',
      monospace;
    color: var(--muted);
  }
  .tl-axis .life {
    background: #d9a441;
    height: 6px;
  }
  .tl-axis .life b {
    bottom: 27px;
    color: #e2c383;
  }
  .tl-axis .life::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: 22px;
    width: 1px;
    height: 4px;
    background: #d9a441;
  }
  .tl-row {
    border-top: 1px solid var(--line);
    padding: 0;
    cursor: default;
  }
  .tl-row:hover,
  .tl-row:focus-visible {
    background: #171c27;
  }
  .tl-mass {
    padding: 8px 0 8px 2px;
    display: flex;
    flex-direction: column;
    line-height: 1.3;
  }
  .tl-mass strong {
    font-size: 15px;
    font-weight: 600;
  }
  .tl-mass small {
    font-size: 12px;
    color: var(--muted);
  }
  .tl-row .grid,
  .tl-row .life-line {
    position: absolute;
    top: 0;
    bottom: 0;
    width: 1px;
    background: #222836;
  }
  .tl-row .life-line {
    background: rgba(217, 164, 65, 0.55);
  }
  .tl-row .range {
    position: absolute;
    top: 50%;
    height: 6px;
    margin-top: -3px;
    border-radius: 3px;
    background: #4b3f86;
    transition:
      left 0.25s ease,
      width 0.25s ease;
  }
  .tl-row .dot {
    position: absolute;
    top: 50%;
    width: 12px;
    height: 12px;
    margin: -6px 0 0 -6px;
    border-radius: 50%;
    background: #a79cf2;
    box-shadow: 0 0 0 2px var(--band);
    transition: left 0.25s ease;
  }
  .tl-value {
    font:
      600 14px 'JetBrains Mono',
      monospace;
    text-align: right;
    white-space: nowrap;
    font-variant-numeric: tabular-nums;
  }
  .tl-detail {
    grid-column: 2 / -1;
    font:
      11px 'JetBrains Mono',
      monospace;
    color: var(--muted);
    padding: 0 0 8px;
    margin-top: -6px;
  }
  .nudge {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 40px;
    padding: 24px;
    border-top: 1px solid var(--line);
    align-items: start;
  }
  .nudge h3 {
    font-size: 18px;
    margin-bottom: 8px;
  }
  .nudge p {
    font-size: 14px;
    color: var(--soft);
  }
  .reading {
    display: grid;
    grid-template-columns: 1.2fr 1fr 1fr;
    gap: 32px;
    margin-top: 40px;
  }
  .reading article {
    border-top: 2px solid #4b3f86;
    padding-top: 16px;
  }
  .reading h3 {
    font-size: 18px;
    margin-bottom: 8px;
  }
  .reading p {
    font-size: 14px;
    color: var(--soft);
  }
  .math {
    margin-top: 36px;
    border: 1px dashed #55607a;
    background: #0e1118;
  }
  .math summary {
    cursor: pointer;
    padding: 16px 20px;
    font-size: 12px;
    color: var(--accent);
  }
  .math-body {
    padding: 0 20px 20px;
    font-size: 14px;
    color: var(--soft);
  }
  .math-body dl div {
    display: grid;
    grid-template-columns: minmax(170px, 26%) 1fr;
    gap: 16px;
    padding: 8px 0;
    border-top: 1px solid var(--line);
  }
  .math-body dt {
    color: var(--muted);
  }
  .math-body dd {
    color: var(--ink);
  }
  .math-body p {
    margin-top: 14px !important;
    max-width: 900px;
  }
  .math-result {
    font-family: 'JetBrains Mono', monospace;
    font-size: 13px;
    color: var(--ink) !important;
    padding: 12px 0;
    border-block: 1px solid var(--line);
    max-width: none !important;
  }
  .math-body strong {
    color: var(--ink);
  }
  .alt-table {
    margin-top: 14px;
    max-width: 640px;
  }

  /* ---------- roadmap ---------- */
  .roadmap {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 16px;
    margin-top: 32px;
  }
  .stage {
    border: 1px solid var(--line-strong);
    background: var(--bg);
    padding: 22px;
  }
  .stage.current {
    border-color: var(--accent);
    background: #141225;
  }
  .stage header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 10px;
    margin-bottom: 14px;
  }
  .stage-v {
    font-size: 28px;
    color: var(--accent);
  }
  .stage h3 {
    font-size: 20px;
  }
  .stage-cost {
    margin-top: 10px !important;
    font-size: 26px !important;
    letter-spacing: -0.02em;
    color: var(--ink) !important;
    line-height: 1.2;
  }
  .stage-cost span {
    display: block;
    font:
      11px 'JetBrains Mono',
      monospace;
    letter-spacing: 0;
    color: var(--muted);
    margin-top: 4px;
  }
  .stage h4 {
    margin-top: 18px;
    font-size: 10px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
    font-weight: 500;
  }
  .stage p,
  .stage li {
    font-size: 13.5px;
    color: var(--soft);
  }
  .stage h4 + p {
    margin-top: 6px !important;
  }
  .stage .exit {
    color: var(--ink);
  }
  .cost {
    display: grid;
    grid-template-columns: 1fr 1.15fr;
    gap: 48px;
    margin-top: 48px;
    align-items: start;
  }
  .cost h3,
  .cost-notes h3 {
    margin-bottom: 12px;
  }
  .cost-key {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 18px;
    list-style: none;
    padding: 0;
    font-size: 12.5px;
    color: var(--soft);
  }
  .cost-key li {
    display: flex;
    align-items: center;
    gap: 7px;
  }
  .cost-key i {
    width: 11px;
    height: 11px;
    border-radius: 2px;
  }
  .c-labour {
    background: #3987e5;
  }
  .c-hardware {
    background: #d95926;
  }
  .c-test {
    background: #199e70;
  }
  .bars {
    margin-top: 18px;
    display: grid;
    gap: 14px;
  }
  .bar-label {
    display: block;
    font-size: 13px;
    color: var(--soft);
    margin-bottom: 5px;
  }
  .bar-label strong {
    font-family: 'JetBrains Mono', monospace;
    color: var(--ink);
    margin-right: 8px;
  }
  .bar-track {
    display: flex;
    align-items: center;
    gap: 2px;
    height: 20px;
    padding-right: 64px;
  }
  .bar-track i {
    height: 100%;
    display: block;
  }
  .bar-track i:nth-of-type(3) {
    border-radius: 0 4px 4px 0;
  }
  .bar-track b {
    font:
      600 13px 'JetBrains Mono',
      monospace;
    margin-left: 8px;
    margin-right: -64px;
    white-space: nowrap;
  }
  .cost-notes {
    display: grid;
    grid-template-columns: 1fr 1.15fr;
    gap: 48px;
    margin-top: 44px;
    padding-top: 32px;
    border-top: 1px solid var(--line);
  }
  .cost-notes p {
    font-size: 14px;
    color: var(--soft);
  }

  /* ---------- open items ---------- */
  .open-list {
    margin-top: 32px;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 28px 32px;
  }
  .open-list article {
    border-top: 2px solid #4b3f86;
    padding-top: 16px;
  }
  .open-list header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 12px;
    margin-bottom: 10px;
  }
  .open-list h3 {
    font-size: 18px;
  }
  .open-list p {
    font-size: 14px;
    color: var(--soft);
  }

  /* ---------- scope ---------- */
  .scope-grid {
    display: grid;
    grid-template-columns: 1fr 1.3fr;
    gap: 56px;
    align-items: start;
  }
  .scope h2 {
    font-size: clamp(24px, 2.6vw, 34px);
  }
  .scope-grid p {
    color: var(--soft);
    max-width: 640px;
  }
  .scope-grid p + p {
    margin-top: 14px !important;
  }
  .scope-grid a {
    color: var(--accent);
    text-underline-offset: 3px;
  }

  /* ---------- references ---------- */
  .refs {
    padding-top: 56px;
    padding-bottom: 56px;
  }
  .ref-list {
    list-style: decimal;
    padding-left: 26px;
    columns: 2;
    column-gap: 48px;
    font-size: 12px;
    line-height: 1.55;
    color: var(--muted);
  }
  .ref-list li {
    margin-bottom: 8px;
    break-inside: avoid;
  }
  .ref-list a {
    text-decoration: none;
    color: var(--soft);
    overflow-wrap: anywhere;
  }
  .ref-list a:hover {
    color: var(--accent);
    text-decoration: underline;
  }
  .ref-list li:target {
    background: #1b1830;
  }

  /* ---------- closing ---------- */
  .closing {
    border-top: 1px solid var(--line);
    background: #141225;
  }
  .closing-grid {
    display: grid;
    grid-template-columns: 1.5fr 1fr;
    gap: 64px;
    align-items: center;
  }
  .closing p:not(.eyebrow) {
    color: var(--soft);
    margin-top: 16px !important;
    max-width: 560px;
  }
  .closing-actions {
    display: flex;
    flex-direction: column;
    gap: 12px;
    max-width: 320px;
    width: 100%;
    justify-self: end;
  }

  /* ---------- responsive ---------- */
  @media (max-width: 1100px) {
    .roadmap {
      grid-template-columns: 1fr 1fr;
    }
    .steps,
    .open-list {
      grid-template-columns: 1fr 1fr;
    }
    .numbers {
      grid-template-columns: 1fr 1fr;
    }
    .numbers li:nth-child(2) {
      border-right: 0;
    }
    .numbers li:nth-child(-n + 2) {
      border-bottom: 1px solid var(--line);
    }
    .calc-controls {
      grid-template-columns: 1fr 1fr;
    }
    .calc-controls > :first-child {
      grid-column: 1 / -1;
    }
    .cost,
    .cost-notes {
      grid-template-columns: 1fr;
      gap: 32px;
    }
  }
  @media (max-width: 900px) {
    .shell {
      padding-left: 20px;
      padding-right: 20px;
    }
    .section {
      padding-top: 56px;
      padding-bottom: 56px;
    }
    .spec-grid {
      columns: 1;
    }
    .hero-grid,
    .pushback,
    .nudge,
    .reading,
    .why-grid,
    .scope-grid,
    .closing-grid {
      grid-template-columns: 1fr;
      gap: 28px;
    }
    .closing-actions {
      justify-self: start;
    }
    .ref-list {
      columns: 1;
    }
    .calc-stats {
      grid-template-columns: 1fr 1fr;
    }
    .calc-stats div:nth-child(2) {
      border-right: 0;
    }
    .calc-stats div:nth-child(-n + 2) {
      border-bottom: 1px solid var(--line);
    }
  }
  @media (max-width: 640px) {
    .slp {
      font-size: 14px;
    }
    .shell {
      padding-left: 16px;
      padding-right: 16px;
    }
    .thesis {
      font-size: 17px;
    }
    .intro {
      font-size: 15px;
    }
    .hero h1 {
      font-size: 38px;
    }
    .steps,
    .open-list,
    .roadmap,
    .numbers,
    .calc-controls {
      grid-template-columns: 1fr;
    }
    .numbers li {
      border-right: 0;
      border-bottom: 1px solid var(--line);
    }
    .numbers li:last-child {
      border-bottom: 0;
    }
    .actions .button {
      flex: 1 1 100%;
