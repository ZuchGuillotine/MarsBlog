<script>
  import {
    timeline,
    nudgeBursts,
    formatDuration,
    orbitalPeriodS,
    orbitalSpeedKmS,
    deorbitDeltaV,
    couplingCases,
  } from '../../lib/debrisLaserModel';

  const calc = document.querySelector<HTMLElement>('[data-calc]');
  if (calc) {
    const cfg = JSON.parse(calc.dataset.config ?? '{}') as { axisMin: number; axisMax: number };
    const lo = Math.log10(cfg.axisMin);
    const hi = Math.log10(cfg.axisMax);
    const pos = (s: number) => Math.min(100, Math.max(0, ((Math.log10(s) - lo) / (hi - lo)) * 100));
    const alt = calc.querySelector<HTMLInputElement>('[data-alt]')!;
    const altOut = calc.querySelector<HTMLElement>('[data-alt-out]')!;
    const q = <T extends HTMLElement>(sel: string) => calc.querySelector<T>(sel)!;
    const checked = (name: string) =>
      Number(calc.querySelector<HTMLInputElement>(`input[name="${name}"]:checked`)?.value ?? 0);

    const update = () => {
      const altKm = Number(alt.value);
      const attitude = checked('attitude');
      const offAxisDeg = checked('direction');
      const base = { altKm, attitude, offAxisDeg };
      altOut.textContent = `${altKm.toLocaleString('en-US')} km`;
      q('[data-stat-v]').textContent = `${orbitalSpeedKmS(altKm).toFixed(2)} km/s`;
      q('[data-stat-dv]').textContent = `${Math.round(deorbitDeltaV(altKm))} m/s`;
      q('[data-stat-j]').textContent = `${timeline({ massKg: 1, cm: couplingCases[1].value, ...base }).impulsePerBurst.toFixed(2)} N·s`;
      q('[data-stat-n]').textContent = (86400 / orbitalPeriodS(altKm)).toFixed(1);

      calc.querySelectorAll<HTMLElement>('[data-row]').forEach(row => {
        const massKg = Number(row.dataset.mass);
        const at = (cm: number) => timeline({ massKg, cm, ...base });
        const mid = at(couplingCases[1].value);
        const fast = at(couplingCases[2].value);
        const slow = at(couplingCases[0].value);
        const range = row.querySelector<HTMLElement>('[data-range]')!;
        range.style.left = `${pos(fast.seconds)}%`;
        range.style.width = `${Math.max(0.6, pos(slow.seconds) - pos(fast.seconds))}%`;
        row.querySelector<HTMLElement>('[data-dot]')!.style.left = `${pos(mid.seconds)}%`;
        row.querySelector<HTMLElement>('[data-value]')!.textContent = formatDuration(mid.seconds);
        row.querySelector<HTMLElement>('[data-detail]')!.textContent =
          `${mid.bursts.toLocaleString('en-US')} bursts · ${formatDuration(fast.seconds)} to ${formatDuration(slow.seconds)}`;
      });

      calc.querySelectorAll<HTMLElement>('[data-nudge]').forEach(row => {
        const b = nudgeBursts({ massKg: Number(row.dataset.mass), cm: couplingCases[1].value, ...base }, 0.01);
        row.querySelector<HTMLElement>('[data-nudge-b]')!.textContent = b.toLocaleString('en-US');
        row.querySelector<HTMLElement>('[data-nudge-t]')!.textContent = formatDuration(b * orbitalPeriodS(altKm));
      });
    };
    calc.addEventListener('input', update);
    calc.querySelector('form')?.addEventListener('submit', e => e.preventDefault());
  }
</script>

