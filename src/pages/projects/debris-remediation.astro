<script>
  import {
    timeline,
    nudge,
    shotsPerOrbit,
    formatDuration,
    formatShots,
    orbitalPeriodS,
    orbitalSpeedKmS,
    deorbitDeltaV,
    couplingCases,
  } from '../../lib/debrisLaserModel';

  const calc = document.querySelector<HTMLElement>('[data-calc]');
  if (calc) {
    const cfg = JSON.parse(calc.dataset.config ?? '{}') as { axisMin: number; axisMax: number; lifeShots: number };
    const lo = Math.log10(cfg.axisMin);
    const hi = Math.log10(cfg.axisMax);
    const pos = (s: number) => Math.min(100, Math.max(0, ((Math.log10(s) - lo) / (hi - lo)) * 100));
    const alt = calc.querySelector<HTMLInputElement>('[data-alt]')!;
    const altOut = calc.querySelector<HTMLElement>('[data-alt-out]')!;
    const q = <T extends HTMLElement>(sel: string) => calc.querySelector<T>(sel)!;
    const checked = (name: string) =>
      calc.querySelector<HTMLInputElement>(`input[name="${name}"]:checked`)?.value ?? '';
    const mid = couplingCases[1].value;

    const update = () => {
      const altKm = Number(alt.value);
      const base = {
        altKm,
        attitude: Number(checked('attitude')),
        offAxisDeg: Number(checked('direction')),
        config: checked('config') || 'a',
      };
      const perOrbit = shotsPerOrbit(base.config, altKm);
      const one = timeline({ massKg: 1, cm: mid, ...base });
      altOut.textContent = `${altKm.toLocaleString('en-US')} km`;
      q('[data-stat-v]').textContent = `${orbitalSpeedKmS(altKm).toFixed(2)} km/s`;
      q('[data-stat-dv]').textContent = `${Math.round(deorbitDeltaV(altKm))} m/s`;
      q('[data-stat-n]').textContent = Math.round(perOrbit).toLocaleString('en-US');
      q('[data-stat-j]').textContent = `${one.impulsePerOrbit.toFixed(one.impulsePerOrbit < 10 ? 2 : 1)} N·s`;

      const life = (cfg.lifeShots / perOrbit) * orbitalPeriodS(altKm);
      calc.querySelectorAll<HTMLElement>('[data-life]').forEach(el => (el.style.left = `${pos(life)}%`));

      calc.querySelectorAll<HTMLElement>('[data-row]').forEach(row => {
        const massKg = Number(row.dataset.mass);
        const at = (cm: number) => timeline({ massKg, cm, ...base });
        const m = at(mid);
        const fast = at(couplingCases[2].value);
        const slow = at(couplingCases[0].value);
        const range = row.querySelector<HTMLElement>('[data-range]')!;
        range.style.left = `${pos(fast.seconds)}%`;
        range.style.width = `${Math.max(0.6, pos(slow.seconds) - pos(fast.seconds))}%`;
        row.querySelector<HTMLElement>('[data-dot]')!.style.left = `${pos(m.seconds)}%`;
        row.querySelector<HTMLElement>('[data-value]')!.textContent = formatDuration(m.seconds);
        row.querySelector<HTMLElement>('[data-detail]')!.textContent =
          `${formatShots(m.shots)} · ${formatDuration(fast.seconds)} to ${formatDuration(slow.seconds)}`;
      });

      calc.querySelectorAll<HTMLElement>('[data-nudge]').forEach(row => {
        const n = nudge({ massKg: Number(row.dataset.mass), cm: mid, ...base }, 0.01);
        row.querySelector<HTMLElement>('[data-nudge-b]')!.textContent = n.shots.toLocaleString('en-US');
        row.querySelector<HTMLElement>('[data-nudge-t]')!.textContent = formatDuration(n.seconds);
      });
    };
    calc.addEventListener('input', update);
    calc.querySelector('form')?.addEventListener('submit', e => e.preventDefault());
  }
</script>

