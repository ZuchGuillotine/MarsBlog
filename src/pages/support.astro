---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Support the Research | Mars Explorer"
  description="Help fund hands-on Mars in-situ resource utilization research, including regolith brick sintering with MGS-1 simulant."
  showDonationCTA={false}
>
  <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <h1 class="text-3xl sm:text-4xl font-display font-bold mb-6">Support the Research</h1>

    <p class="text-lg text-gray-600 dark:text-gray-300 mb-6">
      Mars Explorer is an independent project combining interactive tools, like the 3D globe of
      candidate settlement sites, with hands-on in-situ resource utilization experiments, such as
      our <a href="/construction/sintering-bricks" class="text-mars-red dark:text-mars-orange underline hover:no-underline">solar regolith paving project</a>.
    </p>

    <p class="text-gray-600 dark:text-gray-300 mb-6">
      Your support pays for regolith simulant, mirror hardware, instrumentation, and the time to
      document everything openly so anyone can build on the results.
    </p>

    <div class="space-y-6">
      <section aria-labelledby="support-heading" class="bg-gray-50 dark:bg-gray-800 border border-gwern-border dark:border-mars-brown rounded-lg p-6">
        <h2 id="support-heading" class="text-xl font-display font-semibold mb-3">Support</h2>
        <p class="text-gray-600 dark:text-gray-300 mb-5">
          Choose your own contribution to support the research. Complete your donation securely through Stripe.
        </p>
        <a
          href="https://buy.stripe.com/bJe7sKdfb8wS46lexm63K00"
          class="inline-flex items-center justify-center rounded-lg bg-mars-red px-6 py-3 font-semibold text-white hover:bg-red-800 transition-colors focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-mars-orange"
        >Donate what you want</a>
      </section>

      <section aria-labelledby="investors-heading" class="bg-gray-50 dark:bg-gray-800 border border-gwern-border dark:border-mars-brown rounded-lg p-6">
        <h2 id="investors-heading" class="text-xl font-display font-semibold mb-3">Equity investors reach out</h2>
        <a href="mailto:info@populationmars.com" class="text-mars-red dark:text-mars-orange underline hover:no-underline">info@populationmars.com</a>
      </section>

      <section aria-labelledby="collaboration-heading" class="bg-gray-50 dark:bg-gray-800 border border-gwern-border dark:border-mars-brown rounded-lg p-6">
        <h2 id="collaboration-heading" class="text-xl font-display font-semibold mb-3">Interested in collaborating?</h2>
        <p class="text-gray-600 dark:text-gray-300">
          Send requests to <a href="mailto:info@populationmars.com" class="text-mars-red dark:text-mars-orange underline hover:no-underline">info@populationmars.com</a>.
        </p>
      </section>
    </div>
  </div>
</BaseLayout>
