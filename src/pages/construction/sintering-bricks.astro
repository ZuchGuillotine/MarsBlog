---
// Solar Regolith Paving — project page.
// URL kept at /construction/sintering-bricks so existing links keep working.
import fs from 'node:fs';
import path from 'node:path';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PavingTrainSchematic from '../../components/sintering/PavingTrainSchematic.astro';
import { getCollection } from 'astro:content';
import {
  contact,
  glance,
  heroNumbers,
  problemStats,
  paverFacts,
  paverLimits,
  physics,
  comparison,
  throughput,
  pushback,
  feedstock,
  terrain,
  blade,
  moonMars,
  roadmap,
  experiments,
  risks,
  partners,
  channels,
  references,
  type Kind,
} from '../../data/solarPaving';

// ---- Research log -------------------------------------------------------
const logEntries = (
  await getCollection(
    'projects',
    entry => entry.data.project === 'sintering-bricks' && !entry.data.draft
  )
).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const renderedEntries = await Promise.all(
  logEntries.map(async entry => ({
    entry,
    Content: (await entry.render()).Content,
  }))
);
const dateFormat = new Intl.DateTimeFormat('en-US', {
  year: 'numeric',
  month: 'short',
  day: 'numeric',
  timeZone: 'UTC',
});
const statusLabel: Record<string, string> = {
  planned: 'PLANNED',
  building: 'BUILDING',
  testing: 'TESTING',
  complete: 'COMPLETE',
  failed: 'FAILED / LEARNED',
};

// ---- Hero film ----------------------------------------------------------
// The paving-train film and its poster are produced separately. Sources are
// only emitted once the files exist in public/, so the page never points at a
// missing file. TODO: when /videos/sintering/regolith-paver-poster.jpg lands,
// the poster switches automatically; then drop the concept-image caption.
const inPublic = (p: string) =>
  fs.existsSync(path.join(process.cwd(), 'public', p));
const conceptImage = '/images/sintering/autonomous-solar-cell.webp';
const filmPoster = '/videos/sintering/regolith-paver-poster.jpg';
const filmSources = [
  { src: '/videos/sintering/regolith-paver-film.webm', type: 'video/webm' },
  { src: '/videos/sintering/regolith-paver-film.mp4', type: 'video/mp4' },
].filter(s => inPublic(s.src));
const hasPoster = inPublic(filmPoster);
const poster = hasPoster ? filmPoster : conceptImage;
const hasFilm = filmSources.length > 0;

const kindLabel: Record<Kind, string> = {
  measured: 'Measured',
  reference: 'Reference',
  calculated: 'Calculated',
  projection: 'Projection',
  target: 'Target',
  estimate: 'Estimate',
};
const refIndex = Object.fromEntries(references.map((r, i) => [r.id, i + 1]));
const cite = (...ids: string[]) =>
  ids.map(id => refIndex[id]).filter(Boolean);

const nav = [
  ['problem', 'Problem'],
  ['thesis', 'Thesis'],
  ['train', 'Train'],
  ['materials', 'Materials'],
  ['moon-mars', 'Moon / Mars'],
  ['roadmap', 'Roadmap'],
  ['v1-tests', 'V1 tests'],
  ['risks', 'Risks'],
  ['collaborate', 'Collaborate'],
  ['research-log', 'Log'],
];
---

<BaseLayout
  title="Solar Regolith Paving | Population Mars"
  description="Paving landing pads and roads on the Moon and Mars with concentrated sunlight: melt coarse rock, stir in preheated fines, anneal a 5 cm crystalline road base. V1 test rig in procurement; collaborators and funders wanted."
  ogImage={poster}
>
  <div class="paving">
    <!-- ================= HERO ================= -->
    <header class="hero shell">
      <div class="crumbs">
        <a href="/construction">Infrastructure</a><span aria-hidden="true">/</span
        ><span>Solar regolith paving</span>
      </div>
      <div class="hero-grid">
        <div class="hero-copy">
          <p class="eyebrow">Population Mars · open hardware R&amp;D</p>
          <h1>Solar Regolith Paving</h1>
          <p class="thesis">
            Melt coarse rock with concentrated sunlight, stir in preheated
            fines, and anneal the mush into a 5 cm crystalline road base:
            asphalt, made with sunlight, for landing pads and roads on the Moon
            and Mars.
          </p>
          <p class="status-line">
            <span class="dot" aria-hidden="true"></span><strong>Stage:</strong> V1
            hardware in procurement. No test data yet.
          </p>
          <div class="actions">
            <a class="button primary" href={contact.collaborate}
              >Collaborate <span aria-hidden="true">↗</span></a
            >
            <a class="button" href={contact.fund}
              >Fund V1 <span aria-hidden="true">↗</span></a
            >
            <a class="button ghost" href="#v1-tests"
              >See the V1 test plan <span aria-hidden="true">↓</span></a
            >
          </div>
        </div>
        <aside class="glance" aria-labelledby="glance-title">
          <h2 id="glance-title" class="eyebrow">At a glance</h2>
          <dl>
            {
              glance.map(g => (
                <div>
                  <dt>{g.k}</dt>
                  <dd>{g.v}</dd>
                </div>
              ))
            }
            <div>
              <dt>Research log</dt>
              <dd>
                <a href="#research-log">
                  {logEntries.length}
                  {logEntries.length === 1 ? ' entry' : ' entries'}
                </a>
              </dd>
            </div>
          </dl>
        </aside>
      </div>

      <figure class="film">
        <video
          class="film-video"
          autoplay
          muted
          loop
          playsinline
          controls
          preload={hasFilm ? 'metadata' : 'none'}
          poster={poster}
          aria-label="Film: the solar paving train on Mars (concept)"
          data-film
        >
          {filmSources.map(s => <source src={s.src} type={s.type} />)}
        </video>
        <figcaption>
          {
            hasFilm ? (
              <span>
                Concept film of the V3 paving train (77 s, sound on for the
                score). Machines, stations and temperatures match the design on
                this page.
              </span>
            ) : (
              <span>
                Concept image (AI-generated) of an earlier solar materials-cell
                design. Paving-train film in production.
              </span>
            )
          }
        </figcaption>
      </figure>

      <ul class="numbers" aria-label="Key numbers">
        {
          heroNumbers.map(n => (
            <li>
              <span class="num">{n.value}</span>
              <span class="num-label">{n.label}</span>
              <span class:list={['kind', n.kind]}>{kindLabel[n.kind]}</span>
            </li>
          ))
        }
      </ul>
    </header>

    <!-- ================= STICKY NAV ================= -->
    <nav class="section-nav" aria-label="Page sections">
      <div class="shell nav-inner">
        <div class="nav-links">
          {nav.map(([id, label]) => <a href={`#${id}`}>{label}</a>)}
        </div>
        <a class="nav-cta" href={contact.collaborate}>Collaborate ↗</a>
      </div>
    </nav>

    <!-- ================= 01 PROBLEM ================= -->
    <section class="shell section" id="problem" aria-labelledby="problem-title">
      <p class="eyebrow">01 · The problem</p>
      <h2 id="problem-title">Every landing sandblasts the site.</h2>
      <p class="intro">
        Rocket exhaust hitting loose regolith throws dust and gravel at
        hundreds of metres per second. There are no pads and no roads on the
        Moon or Mars, and every future landing, rover route and habitat site
        needs them.
      </p>
      <div class="stat-row">
        {
          problemStats.map(s => (
            <article class="stat">
              <p class="stat-value">{s.value}</p>
              <p>
                {s.text}
                <sup class="ref">
                  <a href={`#ref-${s.ref}`}>[{refIndex[s.ref]}]</a>
                </sup>
              </p>
            </article>
          ))
        }
      </div>

      <div class="baseline">
        <div>
          <p class="eyebrow">The baseline</p>
          <h3>ESA PAVER, 2023</h3>
          <p>
            The best published result: a laser standing in for a Fresnel lens
            melted lunar simulant into interlocking glass tiles.<sup class="ref"
              ><a href="#ref-gines2023">[{refIndex.gines2023}]</a><a
                href="#ref-esa2023">[{refIndex.esa2023}]</a
              ></sup
            > It proved the idea. Its limits define our design.
          </p>
          <h4>Where it stops</h4>
          <ul class="dash-list">
            {paverLimits.map(l => <li>{l}</li>)}
          </ul>
        </div>
        <dl class="facts">
          {
            paverFacts.map(([k, v]) => (
              <div>
                <dt>{k}</dt>
                <dd>{v}</dd>
              </div>
            ))
          }
        </dl>
      </div>
    </section>

    <!-- ================= 02 THESIS ================= -->
    <section class="band section" id="thesis" aria-labelledby="thesis-title">
      <div class="shell">
        <p class="eyebrow">02 · The thesis</p>
        <h2 id="thesis-title">Melt the rock, not the dust.</h2>
        <p class="intro">
          Do not melt everything to glass, and do not excavate and sieve
          aggregate. Melt pools in the coarse rock, stir medium and fine
          aggregate into the pool, and screed the result: a partially molten
          crystal mush, the way asphalt is aggregate held in a binder. The
          process runs across a wider temperature band than full melting, and
          the product is thicker and rougher.
        </p>
        <div class="physics-grid">
          {
            physics.map(p => (
              <article>
                <h3>{p.title}</h3>
                <p>{p.body}</p>
                <p class="physics-stat">{p.stat}</p>
              </article>
            ))
          }
        </div>
        <p class="src-line">
          Sources: energy [{cite('bouhifd2007').join(', ')}]; cast basalt [{
            cite('eutit', 'eutit2').join(', ')
          }]; PAVER [{cite('gines2023').join(', ')}]; conductivity [{
            cite('hayne2017', 'chaste2025').join(', ')
          }].
        </p>

        <h3 class="table-title" id="comparison">PAVER full melt vs this approach</h3>
        <div class="table-wrap">
          <table class="data-table compare">
            <thead>
              <tr>
                <th scope="col"></th>
                <th scope="col">ESA PAVER (measured / published)</th>
                <th scope="col">Solar paving (design)</th>
              </tr>
            </thead>
            <tbody>
              {
                comparison.map(c => (
                  <tr>
                    <th scope="row">{c.row}</th>
                    <td data-label="ESA PAVER">{c.paver}</td>
                    <td data-label="Solar paving">
                      {c.ours}
                      <span class:list={['kind', c.kind]}>
                        {kindLabel[c.kind]}
                      </span>
                    </td>
                  </tr>
                ))
              }
            </tbody>
          </table>
        </div>

        <details class="math" open>
          <summary>How we got this number: 100 m² at 5 cm in 46–77 days of sunlight</summary>
          <div class="math-body">
            <dl>
              {
                throughput.assumptions.map(([k, v]) => (
                  <div>
                    <dt>{k}</dt>
                    <dd>{v}</dd>
                  </div>
                ))
              }
            </dl>
            <p class="math-result">{throughput.result}</p>
            <p>{throughput.calendar}</p>
            <p>{throughput.paverBasis}</p>
            <p><strong>What this means.</strong> {throughput.honest}</p>
          </div>
        </details>
      </div>
    </section>

    <!-- ================= 03 PUSHBACK ================= -->
    <section class="shell section" id="pushback" aria-labelledby="pushback-title">
      <p class="eyebrow">03 · Where the physics pushes back</p>
      <h2 id="pushback-title">Four problems, four design responses.</h2>
      <p class="intro">
        Each component of the train exists because of one of these.
      </p>
      <ol class="pushback">
        {
          pushback.map(p => (
            <li>
              <span class="pb-n">{p.n}</span>
              <div class="pb-body">
                <h3>{p.problem}</h3>
                <p class="pb-num">{p.numbers}</p>
                <p class="pb-resp">
                  <strong>Response.</strong> {p.response}
                </p>
              </div>
            </li>
          ))
        }
      </ol>
      <p class="src-line">
        Sources: volatiles [{
          cite('leshin2013', 'sutter2021', 'lewis2015', 'gines2023').join(', ')
        }]; expansion [{cite('eutit').join(', ')}].
      </p>
    </section>

    <!-- ================= 04 TRAIN ================= -->
    <section class="band section" id="train" aria-labelledby="train-title-h">
      <div class="shell">
        <p class="eyebrow">04 · The paving train (V3)</p>
        <h2 id="train-title-h">Five cars, one continuous process.</h2>
        <p class="intro">
          A terrestrial asphalt paving train, reimplemented with concentrated
          sunlight in place of hot bitumen. The iris aperture shapes the flux
          into a preheat annulus and a melt core, and blinks closed for clean
          pyrometer readings.
        </p>
        <PavingTrainSchematic />
      </div>
    </section>

    <!-- ================= 05 MATERIALS ================= -->
    <section class="shell section" id="materials" aria-labelledby="materials-title">
      <p class="eyebrow">05 · Materials</p>
      <h2 id="materials-title">Feedstock and tooling.</h2>
      <div class="mat-grid">
        <div>
          <h3 class="col-title">Test feedstock</h3>
          <ul class="mat-list">
            {
              feedstock.map(f => (
                <li>
                  <div class="mat-head">
                    <strong>{f.name}</strong>
                    <span class="tag">{f.role}</span>
                  </div>
                  <p>{f.note}</p>
                </li>
              ))
            }
          </ul>
          <h3 class="col-title">On the Moon and Mars</h3>
          <ul class="mat-list">
            {
              terrain.map(f => (
                <li>
                  <strong>{f.name}</strong>
                  <p>{f.note}</p>
                </li>
              ))
            }
          </ul>
        </div>
        <div>
          <h3 class="col-title">The screed blade</h3>
          <p class="col-lead">
            The paddle works the 1,000–1,200 °C mush behind the hot core, the
            way an asphalt screed works behind the burner, never the 1,450 °C
            pool.
          </p>
          <ul class="mat-list">
            {
              blade.map(f => (
                <li>
                  <strong>{f.name}</strong>
                  <p>{f.note}</p>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
      <p class="src-line">
        Sources: simulants [{cite('lms1', 'mgs1').join(', ')}]; mare basalt [{
          cite('apollo12009').join(', ')
        }]; grain size [{cite('carrier2003').join(', ')}]; Mars rocks [{
          cite('christensen1986', 'golombek2003').join(', ')
        }]; boron nitride [{cite('azombn', 'bn3m', 'jacobson1999').join(', ')}].
      </p>
    </section>

    <!-- ================= 06 MOON / MARS ================= -->
    <section class="band section" id="moon-mars" aria-labelledby="mm-title">
      <div class="shell">
        <p class="eyebrow">06 · Moon and Mars</p>
        <h2 id="mm-title">Moon first, Mars second.</h2>
        <p class="intro">
          The Moon is the easier first deployment: full-strength sunlight,
          vacuum, and well-characterized mare basalt. Lunar landing pads are
          also where agency construction money is going now. Mars is the
          adaptation: larger collectors, sealed optics and mandatory degassing,
          but more coarse rock lying on the surface. The process physics is the
          same, so every lunar result carries over, and human-class Mars
          landers will need pads more than anything landing today.
        </p>
        <div class="table-wrap">
          <table class="data-table mm">
            <thead>
              <tr>
                <th scope="col"></th>
                <th scope="col">Moon</th>
                <th scope="col">Mars</th>
              </tr>
            </thead>
            <tbody>
              {
                moonMars.map(r => (
                  <tr class:list={{ verdict: r.row === 'Verdict' }}>
                    <th scope="row">{r.row}</th>
                    <td data-label="Moon">{r.moon}</td>
                    <td data-label="Mars">{r.mars}</td>
                  </tr>
                ))
              }
            </tbody>
          </table>
        </div>
        <p class="src-line">
          Mars beam irradiance is our estimate from Beer’s law, 590 × e<sup>−τ</sup>
          at the zenith [{cite('appelbaum1989').join(', ')}]; storms [{
            cite('jpl2018').join(', ')
          }]; rocks [{cite('christensen1986', 'golombek2003').join(', ')}];
          volatiles [{cite('leshin2013', 'sutter2021').join(', ')}].
        </p>
      </div>
    </section>

    <!-- ================= 07 ROADMAP ================= -->
    <section class="shell section" id="roadmap" aria-labelledby="roadmap-title">
      <p class="eyebrow">07 · Roadmap</p>
      <h2 id="roadmap-title">Three stages, each with an exit test.</h2>
      <p class="intro">
        Budget sets the order: prove the material on Earth, fly it as a payload
        on someone else’s rover, then build the train.
      </p>
      <div class="roadmap">
        {
          roadmap.map(r => (
            <article class:list={['stage', { current: r.v === 'V1' }]}>
              <header>
                <span class="stage-v">{r.v}</span>
                <span class="tag">{r.status}</span>
              </header>
              <h3>{r.title}</h3>
              <h4>Build</h4>
              <ul class="dash-list">
                {r.build.map(b => (
                  <li>{b}</li>
                ))}
              </ul>
              <h4>Proves</h4>
              <p>{r.proves}</p>
              <h4>Exit criterion</h4>
              <p class="exit">{r.exit}</p>
              <h4>Needs</h4>
              <p>{r.needs}</p>
            </article>
          ))
        }
      </div>
      <p class="note">
        Cost figures are estimates and will be revised as quotes come in.
        V1 on Earth: a ~1 m² Fresnel lens delivers roughly 0.7 kW in clear,
        dry sun, enough for 2–3 cm melt pools. V1 studies the process, not
        throughput.
      </p>
    </section>

    <!-- ================= 08 V1 EXPERIMENTS ================= -->
    <section class="band section" id="v1-tests" aria-labelledby="v1-title">
      <div class="shell">
        <p class="eyebrow">08 · V1 experiment matrix</p>
        <h2 id="v1-title">What V1 measures, and what would stop the project.</h2>
        <p class="intro">
          Thresholds were set before testing. A kill result ends or redirects
          that line of work, and gets published in the log.
        </p>
        <div class="table-wrap">
          <table class="data-table matrix">
            <thead>
              <tr>
                <th scope="col">#</th>
                <th scope="col">Experiment</th>
                <th scope="col">Variable</th>
                <th scope="col">Measurement</th>
                <th scope="col">Confirms</th>
                <th scope="col">Kills</th>
              </tr>
            </thead>
            <tbody>
              {
                experiments.map(e => (
                  <tr>
                    <td class="mx-id" data-label="#">{e.id}</td>
                    <th scope="row">{e.name}</th>
                    <td data-label="Variable">{e.variable}</td>
                    <td data-label="Measurement">{e.measure}</td>
                    <td data-label="Confirms" class="ok">{e.confirm}</td>
                    <td data-label="Kills" class="no">{e.kill}</td>
                  </tr>
                ))
              }
            </tbody>
          </table>
        </div>
        <p class="note">
          Every run is logged with the
          <a href="/research/sintering/experiment-record.md" download
            >experiment-record template ↓</a
          > (bed type, preheat and filler temperature, filler fraction, hood
          state, LWIR cooling rate, rake force).
        </p>
      </div>
    </section>

    <!-- ================= 09 RISKS ================= -->
    <section class="shell section" id="risks" aria-labelledby="risks-title">
      <p class="eyebrow">09 · Risks</p>
      <h2 id="risks-title">Known risks.</h2>
      <div class="risk-list">
        {
          risks.map(r => (
            <article>
              <h3>{r.risk}</h3>
              <p>{r.detail}</p>
              <p class="risk-resp">{r.response}</p>
            </article>
          ))
        }
      </div>
    </section>

    <!-- ================= 10 COLLABORATE ================= -->
    <section class="cta-band section" id="collaborate" aria-labelledby="collab-title">
      <div class="shell">
        <p class="eyebrow">10 · Collaborate or fund</p>
        <h2 id="collab-title">Who we need, and what for.</h2>
        <p class="intro">
          The project crosses optics, ceramics, controls, robotics and
          planetary science. Each line below is a specific piece of work.
        </p>
        <div class="partner-grid">
          {
            partners.map((p, i) => (
              <article>
                <span class="p-n">{String(i + 1).padStart(2, '0')}</span>
                <h3>{p.who}</h3>
                <p>{p.can}</p>
              </article>
            ))
          }
        </div>

        <div class="fund">
          <div>
            <h3>Funding by stage</h3>
            <table class="data-table fund-table">
              <tbody>
                <tr>
                  <th scope="row">V1 · Earth test head</th>
                  <td>$15k–40k <span class="kind estimate">Estimate</span></td>
                </tr>
                <tr>
                  <th scope="row">V2 · ride-along payload</th>
                  <td>$0.3M–1.5M <span class="kind estimate">Estimate</span></td>
                </tr>
                <tr>
                  <th scope="row">V3 · paving train</th>
                  <td>$5M+, partner-led <span class="kind estimate">Estimate</span></td>
                </tr>
              </tbody>
            </table>
            <p class="note">
              V1 covers optics and 4-DOF head, iris, two-colour pyrometer,
              LWIR camera, simulants, argon tent, BN coatings and coupon
              characterization.
            </p>
          </div>
          <div>
            <h3>Channels we are pursuing</h3>
            <ul class="channel-list">
              {
                channels.map(c => (
                  <li>
                    <strong>{c.name}</strong>
                    <span>
                      {c.note}
                      <sup class="ref">
                        <a href={`#ref-${c.ref}`}>[{refIndex[c.ref]}]</a>
                      </sup>
                    </span>
                  </li>
                ))
              }
            </ul>
          </div>
        </div>

        <div class="actions cta-actions">
          <a class="button primary" href={contact.collaborate}
            >Collaborate <span aria-hidden="true">↗</span></a
          >
          <a class="button" href={contact.fund}
            >Fund V1 <span aria-hidden="true">↗</span></a
          >
          <p class="contact-note">
            Both open an email to <a href={`mailto:${contact.email}`}
              >{contact.email}</a
            >. Say which experiment or stage you can help with.
          </p>
        </div>
      </div>
    </section>

    <!-- ================= 11 LATER ================= -->
    <section class="shell section later" id="later" aria-labelledby="later-title">
      <div class="later-grid">
        <div>
          <p class="eyebrow">11 · Later research threads</p>
          <h2 id="later-title">Bricks and heat storage.</h2>
          <p>
            The project began as solar-sintered MGS-1 bricks. Paving comes
            first because it is one continuous process with no molds or
            handling. Two threads stay on the list and reuse V1 hardware:
          </p>
          <ul class="dash-list">
            <li>
              <strong>Bricks and pavers.</strong> Sintered or melt-cast blocks
              for walls, arches, berms and interlocking pavers; strength,
              joints and thermal cycling.
            </li>
            <li>
              <strong>Thermal battery.</strong> Brick enclosures of loose
              regolith charged with concentrated sunlight by day to deliver
              heat through the night (Martian nights reach about −80 °C).
            </li>
          </ul>
        </div>
        <figure class="concept">
          <img
            src={conceptImage}
            srcset="/images/sintering/autonomous-solar-cell-840.webp 840w, /images/sintering/autonomous-solar-cell.webp 1672w"
            sizes="(max-width: 900px) 92vw, 560px"
            width="1672"
            height="941"
            loading="lazy"
            alt="Concept render of a compact Mars materials cell with a faceted solar concentrator, grading blade, hopper, small hot processing spot and an arm lifting a paver."
          />
          <figcaption>Concept image, AI-generated: a later brick-and-paver cell.</figcaption>
        </figure>
      </div>
    </section>

