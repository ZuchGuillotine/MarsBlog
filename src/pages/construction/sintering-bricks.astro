          >
          <a class="button" href={contact.fund}
            >Fund V1 <span aria-hidden="true">↗</span></a
          >
          <a href="/construction" class="back-link">← Back to infrastructure</a>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>

<script>
  // Respect reduced-motion: stop the hero film and give the viewer controls.
  const film = document.querySelector<HTMLVideoElement>('[data-film]');
  if (film) {
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');
    const apply = () => {
      if (reduce.matches) {
        film.pause();
        film.removeAttribute('autoplay');
        film.controls = film.querySelector('source') !== null;
      }
    };
    apply();
    reduce.addEventListener('change', apply);
  }
</script>

