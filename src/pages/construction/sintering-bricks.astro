---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SolarProcessExplorer from '../../components/sintering/SolarProcessExplorer.astro';
import { getCollection } from 'astro:content';

const allEntries = await getCollection(
  'projects',
  entry => entry.data.project === 'sintering-bricks' && !entry.data.draft
);
const logEntries = allEntries.sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
const renderedEntries = await Promise.all(
  logEntries.map(async entry => ({
    entry,
    Content: (await entry.render()).Content,
  }))
);
const dateFormat = new Intl.DateTimeFormat('en-US', {
  year: 'numeric',
  month: 'short',
  day: 'numeric',
  timeZone: 'UTC',
});
const expertise =
  'mailto:feedback@haidaa.com?subject=Population%20Mars%20%E2%80%94%20solar%20sintering%20collaboration';
const support =
  'mailto:feedback@haidaa.com?subject=Population%20Mars%20%E2%80%94%20support%20a%20solar%20sintering%20test';
const generations = [
  {
    version: 'V1',
    status: 'CURRENT DEVELOPMENT',
    title: 'Find the process window.',
    name: 'Physics / material process window',
    build:
      'A person-sized, manually controlled solar test rig. An experimental instrument for learning what the material does.',
    test: 'Map the transition from loose MGS-1 to bonded ceramic, glazing and melt. Make stationary coupons, straight tracks and small rastered surfaces.',
    learn:
      'Can we reproduce a known material state—and explain how the feedstock, delivered flux and thermal history produced it?',
    gate: 'A reproducible process window, with characterized samples.',
    hardware: [
      'Satellite-style parabolic dish with replaceable mirror facets',
      'Controllable mirror shielding / aperture sections and safe beam interruption',
      'MGS-1 or closely characterized Mars-regolith simulant',
      'Refractory firing surface, removable molds or coupon substrates',
      'Manual X/Y material stage and Z-axis focal adjustment',
      'Pyrometer, substrate thermocouple, protected camera and irradiance measurement',
      'Physical shielding and remote observation',
    ],
    questions: [],
  },
  {
    version: 'V2',
    status: 'PLANNED · DEPENDS ON V1',
    title: 'Automate what works.',
    name: 'Motion + closed-loop solar CNC',
    build:
      'Motorized X/Y motion, Z/focal adjustment and solar tracking, with an electronic aperture and remotely actuated beam shutter.',
    test: 'Use pyrometry and imaging to adjust scan speed, aperture, focal offset or shutter duty cycle as sunlight and feedstock conditions change.',
    learn:
      'Can we join neighboring tracks, manage the cooling wake and produce repeatable pieces with acceptable dimensions?',
    gate: 'Repeatable tiles or small fields under changing conditions.',
    hardware: [
      'Actuators, encoders, limit switches and safety interlocks',
      'Programmed toolpaths and synchronized data logging',
      'Fast pyrometer feedback and visible melt-pool imaging',
      'Thermal imaging of the cooling wake when available',
      'Controller state: X/Y/Z, scan velocity, incident solar power, aperture, temperature and observed material state',
    ],
    questions: [
      'Can a new track bond without cracking an earlier one?',
      'Can the controller compensate for changing sunlight?',
      'Can we deliberately manage the cooling wake?',
      'When does a rough, partially sintered surface outperform smooth vitrified glass?',
      'What dimensional accuracy can we repeat?',
    ],
  },
  {
    version: 'V3',
    status: 'CONCEPT · DEPENDS ON V1 + V2',
    title: 'Integrate the cell.',
    name: 'Autonomous regolith construction cell',
    build:
      'Coordinate preparation, solar processing, cooling, inspection and robotic handling in a compact planetary materials cell.',
    test: 'Survey and classify material; prepare layers; process and inspect them; reject or recycle failures; transport, place and verify useful components.',
    learn:
      'Which products and machine architecture earn their complexity through measured performance, recoverability and low imported mass?',
    gate: 'An integrated process selected by evidence, then tested for Mars.',
    hardware: [
      'Material preparation: blade / scoop, screening, metering, spreading and compaction',
      'Solar processing: tracking optics, active aperture, focal control, motion, shielding and beam dump / safe shutdown',
      'Thermal management: pyrometry, thermal imaging, scan strategy and cooling covers; possible heat recovery / storage',
      'Robotic handling: arm or gantry, tool changing, molds, components, rejection / recycling and placement',
      'Inspection: dimensions, thermal history, cracks / defects and explicit pass/fail criteria',
      'Autonomy: toolpaths, material-state feedback, fault detection, jam recovery, reversible motions, safe recovery poses and logging',
      'Eventually: coordination between several specialized machines',
    ],
    questions: [],
  },
];
const experiments = [
  [
    '01',
    'Characterize the focus',
    'Measure the optical focal region and spot geometry.',
  ],
  [
    '02',
    'Map delivered flux',
    'Compare aperture settings and focal offsets against incident irradiance.',
  ],
  [
    '03',
    'Heat stationary samples',
    'Record thermal history, material response and failure observations.',
  ],
  [
    '04',
    'Locate material-state boundaries',
    'Distinguish necking, useful sintering, glazing, stable melt and bubbling / ejection.',
  ],
  [
    '05',
    'Make straight tracks',
    'Vary scan speed and dose; section tracks to measure bonded depth.',
  ],
  [
    '06',
    'Join a small raster',
    'Vary track spacing and cooling strategy; inspect the previous tracks.',
  ],
  [
    '07',
    'Characterize and repeat',
    'Section samples and test density, porosity, cracking and mechanical behavior.',
  ],
];
const collaborators = [
  [
    '01',
    'Optics / solar thermal',
    'Concentrators, flux measurement, aperture design, tracking and dust-tolerant optics.',
  ],
  [
    '02',
    'Materials / ceramics',
    'Basaltic minerals, sintering, vitrification, glass-ceramics, fracture and thermal cycling.',
  ],
  [
    '03',
    'Robotics / motion control',
    'Rails, actuators, encoders, manipulators and rugged autonomous machinery.',
  ],
  [
    '04',
    'Controls',
    'Pyrometry, feedback, adaptive scan rate, aperture control and fault handling.',
  ],
  [
    '05',
    'Computer vision',
    'Melt-pool observation, defect detection, cooling-state estimation and process-state classification.',
  ],
  [
    '06',
    'Planetary science',
    'Simulant fidelity, pressure and atmosphere effects, dust behavior and scale assumptions.',
  ],
  [
    '07',
    'Construction / manufacturing',
    'Surface preparation, paver geometry, tooling, molds, structural testing and repairability.',
  ],
  [
    '08',
    'Test facilities / universities',
    'Mechanical characterization, microscopy, thermal cycling, reduced-pressure testing, spectroscopy and solar-flux measurement.',
  ],
];
const measurements = [
  [
    'Feedstock + bed',
    'Particle-size distribution; simulant batch; green density / compaction; layer thickness.',
    'Density, porosity, bonded depth and mass loss.',
  ],
  [
    'Optics + motion',
    'Solar irradiance; aperture fraction; spot diameter; focal distance / offset; scan speed; track spacing.',
    'Track and melt-pool dimensions, surface texture and dimensional accuracy.',
  ],
  [
    'Thermal history',
    'Thermal dose; peak / focal temperature; dwell time; heating ramp; cooling rate.',
    'Cracking, surface defects, thermal-cycle survival and compressive / flexural behavior where practical.',
  ],
  [
    'Repeatability',
    'Repeat the same configuration and compare runs as sunlight and feedstock change.',
    'Variation, uncertainty and the limits of a reproducible process window.',
  ],
];
---

<BaseLayout
  title="Solar Regolith Sintering | Population Mars"
  description="An open development program: manual MGS-1 solar material tests, closed-loop solar CNC, and a future autonomous regolith construction cell. Follow the evidence and contribute expertise."
  ogImage="/images/sintering/autonomous-solar-cell.webp"
>
  <div class="solar-program">
    <header class="project-hero shell">
      <div class="project-id">
        <a href="/construction">INFRASTRUCTURE /</a><span
          >MGS1_SINTERING.project</span
        ><span class="status"><i></i> V1 · CURRENT DEVELOPMENT</span>
      </div>
      <div class="hero-grid">
        <div>
          <p class="eyebrow">POPULATION MARS / OPEN MATERIALS R&D</p>
          <h1>
            From regolith<br />to infrastructure<span class="accent">.</span>
          </h1>
          <p class="mission">
            Use concentrated sunlight and locally available mineral feedstock to
            develop increasingly autonomous machines capable of building useful
            planetary infrastructure.
          </p>
          <div class="actions">
            <a class="button primary" href="#roadmap"
              >EXPLORE THE ROADMAP <span aria-hidden="true">↘</span></a
            ><a class="button" href="#research-log"
              >READ THE RESEARCH LOG <span aria-hidden="true">↓</span></a>
          </div>
        </div>
        <aside class="reality-panel" aria-label="Current project status">
          <p class="eyebrow">THE EXPERIMENT TODAY</p>
          <h2>Small on purpose.<br />Measured before scaled.</h2>
          <dl>
            <div><dt>FEEDSTOCK</dt><dd>MGS-1 Mars simulant</dd></div><div>
              <dt>ENERGY</dt><dd>Concentrated sunlight</dd>
            </div><div>
              <dt>DEVELOPMENT</dt><dd>Manual terrestrial test rig</dd>
            </div><div>
              <dt>PUBLISHED RECORD</dt><dd>
                {logEntries.length}
                {
                  logEntries.length === 1
                    ? 'research-log entry'
                    : 'research-log entries'
                }
              </dd>
            </div>
          </dl>
          <p class="status-note">
            The published record currently documents the kickoff and
            experimental plan. A completed rig, validated material process
            window and autonomous construction have not yet been demonstrated in
            this log.
          </p>
          <a class="text-link" href="#research-log"
            >Check the evidence <span aria-hidden="true">↗</span></a
          >
        </aside>
      </div>
    </header>

    <nav class="section-nav" aria-label="Solar sintering sections">
      <div class="shell nav-links">
        <a href="#vision">01 / VISION</a><a href="#roadmap">02 / ROADMAP</a><a
          href="#process">03 / PROCESS</a
        ><a href="#measurements">04 / MEASUREMENTS</a><a href="#collaborate"
          >05 / COLLABORATE</a
        ><a href="#research-log">06 / RESEARCH LOG</a>
      </div>
    </nav>

    <section
      class="shell section vision"
      id="vision"
      aria-labelledby="vision-title"
    >
      <div class="section-top">
        <p class="eyebrow">01 / THE LONG VIEW</p><span class="tag"
          >V3 CONCEPT · NOT BUILT</span>
      </div>
      <figure class="system-render">
        <img
          src="/images/sintering/autonomous-solar-cell.webp"
          srcset="/images/sintering/autonomous-solar-cell-840.webp 840w, /images/sintering/autonomous-solar-cell.webp 1672w"
          sizes="(max-width: 1280px) 94vw, 1200px"
          width="1672"
          height="941"
          alt="Conceptual Mars materials cell with a faceted solar concentrator, grading blade, metering hopper, small hot processing spot, inspection sensors and an industrial arm handling a paver."
          fetchpriority="high"
        />
        <figcaption>
          <strong>ONE POSSIBLE MATURE DESCENDANT</strong><span
            >AI-generated engineering concept. Optical layout, mechanisms and
            scale are illustrative, not a validated design or a photograph of
            existing hardware.</span>
        </figcaption>
      </figure>
      <div class="split vision-copy">
        <div>
          <h2 id="vision-title">Where this could lead.</h2><p class="lead">
            A coordinated materials cell.<br />One controlled track at a time.
          </p>
        </div><div>
          <p>
            A compact machine works a prepared patch of Martian ground: collect
            and condition the feedstock, spread a repeatable layer, compact it
            when needed, then move a small high-temperature sintering or melt
            zone along programmed paths.
          </p><p>
            A lightweight deployable concentrator tracks the Sun. Active
            aperture shielding, focal adjustment, rapid beam interruption and
            deliberate defocusing regulate the input. The objective is a useful
            material state, with closed-loop thermal control.
          </p><p>
            Rugged rails, rollers, augers, shields and a compact arm do the
            work. The arm could handle molds, position sensors, remove rejects,
            swap tools, clear the bed and eventually place finished components.
          </p>
        </div>
      </div>
      <div class="regimes">
        <article>
          <p class="eyebrow">THERMAL ROUTE A</p><h3>
            Bond without fully melting.
          </h3><p class="route">
            Compaction <b>→</b> partial sintering <b>→</b> strong bonded ceramic
            layer
          </p>
        </article><article>
          <p class="eyebrow">THERMAL ROUTE B</p><h3>
            Melt where it earns its place.
          </h3><p class="route">
            Controlled melt <b>→</b> glass / glass-ceramic <b>→</b> managed cooling
            / recrystallization
          </p>
        </article>
      </div>
      <div class="thermal-train">
        <div class="thermal-heading">
          <p class="eyebrow">THE THERMAL-MANAGEMENT TRAIN</p><p>
            Controlling the cooling is part of making the material.
          </p>
        </div><ol>
          <li>
            <span class="thermal-dot hot"></span><strong
              >Active solar spot</strong
            ><span>Small sinter / melt zone</span>
          </li><li>
            <span class="thermal-dot warm"></span><strong
              >Hot consolidated material</strong
            ><span>Newly bonded track</span>
          </li><li>
            <span class="thermal-dot cooling"></span><strong
              >Controlled cooling</strong
            ><span>Manage thermal stress</span>
          </li><li>
            <span class="thermal-dot inspection"></span><strong
              >Thermal + visible inspection</strong
            ><span>Observe the cooling wake</span>
          </li><li>
            <span class="thermal-dot finished"></span><strong
              >Finished surface</strong
            ><span>Verify before use</span>
          </li>
        </ol>
      </div>
      <p class="quiet">
        Possible outputs: stabilized ground, pavers, tiles, protective facings,
        interlocking components, berm or wall elements, thermal-storage
        structures and eventually larger compression-dominant infrastructure.
        The experiments should select the architecture.
      </p>
    </section>

    <section class="section comparison-band" aria-labelledby="now-title">
      <div class="shell">
        <div class="comparison">
          <article>
            <p class="eyebrow">NOW / V1 DEVELOPMENT</p><h2 id="now-title">
              An instrument<br />for learning.
            </h2><p>
              A person-sized Earth rig: mirrored dish, refractory receiver,
              MGS-1, sensors and manually controlled motion.
            </p><p class="purpose">
              <strong>Purpose</strong> Discover the physics and material process
              window.
            </p>
          </article><div
            class="comparison-link"
            aria-label="Measure, learn, automate, scale"
          >
            <span>MEASURE</span><b>↓</b><span>LEARN</span><b>↓</b><span
              >AUTOMATE</span
            ><b>↓</b><span>SCALE</span>
          </div><article>
            <p class="eyebrow">TARGET / LONG-RANGE CONCEPT</p><h2>
              A cell for<br />making infrastructure.
            </h2><p>
              Local feedstock preparation, closed-loop solar processing,
              controlled cooling, inspection and robotic placement.
            </p><p class="purpose">
              <strong>Purpose</strong> Turn local minerals into useful infrastructure
              with minimal imported consumables.
            </p>
          </article>
        </div>
      </div>
    </section>

    <section class="shell section" id="roadmap" aria-labelledby="roadmap-title">
      <div class="section-top">
        <p class="eyebrow">02 / DEVELOPMENT ROADMAP</p><span class="meta"
          >PROGRESSION BY EVIDENCE, NOT DATES</span>
      </div>
      <h2 id="roadmap-title">Measure. Learn. Automate. Scale.</h2><p
        class="intro"
      >
        Each generation answers a different question. V1 establishes the
        process; V2 controls it; V3 integrates the operations. Later generations
        remain conditional on what the earlier experiments teach us.
      </p>
      <div class="roadmap-grid">
        {
          generations.map(g => (
            <article
              class:list={['generation', { current: g.version === 'V1' }]}
            >
              <>
                <div class="generation-head">
                  <>
                    <span class="version">{g.version}</span>
                    <span class="tag">{g.status}</span>
                  </>
                </div>
                <p class="generation-name">{g.name}</p>
                <h3>{g.title}</h3>
                <dl>
                  <>
                    <dt>WHAT ARE WE BUILDING?</dt>
                    <dd>{g.build}</dd>
                    <dt>WHAT ARE WE TESTING?</dt>
                    <dd>{g.test}</dd>
                    <dt>WHAT MUST WE LEARN?</dt>
                    <dd>{g.learn}</dd>
                  </>
                </dl>
                <div class="gate">
                  <>
                    <span>ADVANCE WHEN</span>
                    <p>{g.gate}</p>
                  </>
                </div>
                <details>
                  <summary>Hardware, controls &amp; subsystems</summary>
                  <ul class="bullets">
                    {g.hardware.map(item => (
                      <li>{item}</li>
                    ))}
                  </ul>
                  {g.questions.length > 0 && (
                    <>
                      <h4>Questions for V2</h4>
                      <ul class="bullets">
                        {g.questions.map(item => (
                          <li>{item}</li>
                        ))}
                      </ul>
                    </>
                  )}
                </details>
              </>
            </article>
          ))
        }
      </div>
      <div class="protocol">
        <div>
          <p class="eyebrow">V1 / PROPOSED EXPERIMENT SEQUENCE</p><h3>
            Build a map of<br />what the material does.
          </h3><p>
            The milestone is a reproducible processing window that produces a
            known material state. A molten sample alone does not establish that
            window.
          </p><span class="tag">ALL STEPS BELOW ARE PLANNED</span>
        </div><ol class="experiment-list">
          {
            experiments.map(([n, title, description]) => (
              <li>
                <>
                  <span>{n}</span>
                  <div>
                    <>
                      <h4>{title}</h4>
                      <p>{description}</p>
                    </>
                  </div>
                </>
              </li>
            ))
          }
        </ol>
      </div>
      <div class="v2-path">
        <p class="eyebrow">V2 / INCREASING PROCESS COMPLEXITY</p><p>
          Coupon <b>→</b> parallel tracks <b>→</b> small raster patch <b>→</b> approximately
          30 cm prepared bed <b>→</b> interlocking tile / paver
        </p>
      </div>
      <details class="full-details">
        <summary>Material-state classification: what vision could add</summary
        ><p>
          Proposed V2 classes pair visible morphology with temperature and
          thermal history. Computer vision complements pyrometry; it does not
          replace temperature measurement. Early particle necking may require
          microscopy or sectioning to confirm.
        </p><ol class="state-list" start="0">
          {
            [
              'Loose / unbonded',
              'Early necking',
              'Useful sintering',
              'Partial melt',
              'Stable melt pool',
              'Excessive melt / bubbling',
              'Ejection / process failure',
            ].map((state, i) => (
              <li>
                <span>{i}</span>
                {state}
              </li>
            ))
          }
        </ol><p>
          Train and validate classifications against characterized samples
          before using them for control. A camera label alone is not proof of
          internal strength or bonded depth.
        </p>
      </details>
      <p class="callout">
        V3 is not a frozen design. A thin bonded layer over compacted ground may
        prove more useful than a solid brick. Interlocking pavers, replaceable
        wearing surfaces, structural shells, roads, landing-area components,
        thermal-storage blocks and radiation / thermal infrastructure all remain
        candidate uses.
      </p>
    </section>

    <section
      class="process-band section"
      id="process"
      aria-labelledby="process-title"
    >
      <div class="shell">
        <div class="section-top">
          <p class="eyebrow">03 / SYSTEM ARCHITECTURE</p><span class="tag"
            >CONCEPTUAL WORKFLOW</span>
        </div><h2 id="process-title">A process, with feedback.</h2><p
          class="intro"
        >
          The manufacturing loop includes what happens before the hot spot, what
          happens after it, and what happens when a part fails inspection.
        </p>
        <SolarProcessExplorer />
        <div class="flow-layout">
          <ol class="material-flow" aria-label="Material processing flow">
            <li>LOCAL REGOLITH</li><li>COLLECT / SCREEN</li><li>SPREAD</li><li>
              COMPACT
            </li><li class="solar-step">
              SOLAR PROCESSING <span>Small moving sinter / melt zone</span>
            </li><li>CONTROLLED COOLING</li><li>INSPECT</li>
          </ol><div class="feedback-panel">
            <p class="eyebrow">FEEDBACK TO SOLAR PROCESSING</p><div
              class="sensor-group"
            >
              <span>PYROMETER</span><b>+</b><span>VISIBLE CAMERA</span><b>+</b
              ><span>THERMAL CAMERA</span>
            </div><span class="flow-arrow" aria-hidden="true">↓</span><div
              class="controller"
            >
              PROCESS CONTROLLER
            </div><span class="flow-arrow" aria-hidden="true">↓</span><div
              class="actuators"
            >
              APERTURE / FOCUS / SCAN SPEED<br /><span
                >+ beam interruption / shutter duty cycle</span>
            </div><p class="feedback-return">
              ↺ Adjust the solar process; observe the response.
            </p><p>
              Track temperature, melt-pool dimensions, irradiance, aperture,
              focal distance, scan velocity, layer depth, compaction, cooling
              rate and surface defects.
            </p><p class="quiet">
              Fault handling needs a safe shutdown, reversible motions and
              recoverable poses. Autonomy includes stopping and rejecting bad
              material.
            </p>
          </div><div class="inspection-branches">
            <div>
              <span class="tag pass">PASS</span><strong
                >Transport → place / use → verify</strong>
            </div><div>
              <span class="tag fail">FAIL / LEARN</span><strong
                >Reject → recondition / recycle</strong
              ><p>
                Return suitable material to preparation; record the failure and
                check whether reuse is possible.
              </p>
            </div>
          </div>
        </div>
        <p class="quiet">
          A mature field workflow would also survey the site and classify local
          feedstock before collection. No integrated autonomous cell is claimed
          today.
        </p>
      </div>
    </section>

    <section class="shell section" aria-labelledby="solar-title">
      <div class="split">
        <div>
          <p class="eyebrow">THE ENERGY HYPOTHESIS</p><h2 id="solar-title">
            Why direct solar?
          </h2><p class="lead">
            Local minerals.<br />Local sunlight.<br />Less conversion hardware?
          </p>
        </div><div>
          <p>
            Mars construction faces a severe logistics constraint: imported
            hardware and consumables are costly. Regolith and sunlight are
            locally available. Optical concentration may remove some
            energy-conversion equipment from the heating chain.
          </p><div class="energy-chain">
            <span>ELECTRIC HEATING PATH</span><p>
              Sunlight → photovoltaic electricity → power electronics → laser /
              heater → regolith
            </p>
          </div><div class="energy-chain direct">
            <span>DIRECT SOLAR PATH</span><p>
              Sunlight → optical concentration → regolith
            </p>
          </div><p>
            The shorter chain is a hypothesis worth testing, not proof of lower
            total mass or higher efficiency. Tracking, shielding, dust
            management, motion, sensing and control still require hardware and
            auxiliary power.
          </p><p>
            Direct solar competes with—and may complement—microwave processing,
            resistive heating, lasers, electric furnaces, mechanical compaction,
            binders and hybrid processes. This program exists partly to find
            where it actually makes sense.
          </p>
        </div>
      </div>
      <div class="metric-strip">
        <p class="eyebrow">COMPARE THE WHOLE SYSTEM</p><ul>
          {
            [
              'Infrastructure kg / imported hardware kg',
              'Throughput',
              'Energy efficiency',
              'Collector area',
              'Controllability',
              'Strength / porosity',
              'Thermal shock',
              'Surface traction',
              'Repairability',
              'Dust tolerance',
              'Autonomous operability',
            ].map(metric => <li>{metric}</li>)
          }
        </ul>
      </div>
    </section>

    <section
      class="measurement-band section"
      id="measurements"
      aria-labelledby="measurements-title"
    >
      <div class="shell">
        <p class="eyebrow">04 / WHAT WE MEASURE</p><h2 id="measurements-title">
          A hot spot is only the beginning.
        </h2><p class="intro">
          Every run should connect inputs, thermal history and a characterized
          result. Publish the conditions and the uncertainty alongside the
          photograph.
        </p><div class="measurement-table">
          <div class="measurement-row table-heading">
            <span>EXPERIMENT DOMAIN</span><span>CONTROL / RECORD</span><span
              >CHARACTERIZE</span>
          </div>{
            measurements.map(([domain, input, output]) => (
              <div class="measurement-row">
                <>
                  <h3>{domain}</h3>
                  <div>
                    <>
                      <span class="mobile-label">CONTROL / RECORD</span>
                      <p>{input}</p>
                    </>
                  </div>
                  <div>
                    <>
                      <span class="mobile-label">CHARACTERIZE</span>
                      <p>{output}</p>
                    </>
                  </div>
                </>
              </div>
            ))
          }
        </div><div class="measurement-notes">
          <p>
            <strong
              >Initial temperature target: approximately 1000–1200°C.</strong
            > This preserves the original focal-zone research target, not a measured
            result or a universal sintering recipe. Composition, dose and cooling
            determine the material state.
          </p><p>
            <strong>Measure carefully.</strong> Pyrometry depends on emissivity,
            reflections and field of view. A substrate thermocouple helps interpret
            the thermal history but does not directly measure the moving surface
            pool. Pair sensor traces with imaging and sectioned samples.
          </p>
        </div>
      </div>
    </section>

    <section class="shell section" aria-labelledby="earth-title">
      <div class="split">
        <div>
          <p class="eyebrow">TERRESTRIAL TESTBED / PLANETARY PURPOSE</p><h2
            id="earth-title"
          >
            Why build this<br />on Earth?
          </h2>
        </div><div>
          <p class="lead">Learn cheaply before testing expensively.</p><p>
            The Earth machine lets us investigate optics, materials, thermal
            control, motion and autonomy together, and eliminate failure modes
            before environmental simulation.
          </p><p>
            Earth results are not direct proof of Mars operation. Future tests
            must address pressure, atmosphere, gravity, solar availability, dust
            behavior and Martian thermal conditions. Simulant fidelity and
            site-to-site material variation also matter.
          </p><p class="quiet">
            Possible Earth-side value includes low-fuel mineral consolidation,
            remote construction, autonomous aggregate processing, off-grid
            high-temperature processing and disaster / austere-site construction
            research. Mars remains the mission.
          </p>
        </div>
      </div>
      <details class="full-details original-research">
        <summary
          >Original research threads: bricks, structures & thermal storage</summary
        ><div class="research-threads">
          <article>
            <p class="eyebrow">01 / SOLAR SINTERING</p><h3>
              MGS-1 to bonded material
            </h3><p>
              Concentrate sunlight onto packed regolith molds to explore grain
              bonding without added binder or combustion fuel. Track particle
              size, compaction, dwell time and ramp rate; test strength, density
              and thermal cycling. Lightweight mirrors are attractive, but
              cleaning and dust tolerance must be demonstrated.
            </p>
          </article><article>
            <p class="eyebrow">02 / BRICK STRUCTURES</p><h3>
              Test compression-dominant forms
            </h3><p>
              Explore walls, arches and vaults; interlocking geometries versus
              mortared joints; candidate sulfur-based mortar / concrete and
              sintered-in-place seams. Measure load capacity and joint thermal
              expansion. Mars's approximately 0.38g changes self-weight loads,
              but does not establish structural safety or allowable spans.
            </p><p>
              Potential uses include protective habitat shells, windbreaks and
              radiation-shielding mass, subject to structural testing.
            </p>
          </article><article>
            <p class="eyebrow">03 / THERMAL BATTERY</p><h3>
              Store heat in local material
            </h3><p>
              Investigate brick enclosures filled with loose regolith, charged
              by concentrated solar heat during the day. Measure heat-retention
              curves and insulation configurations; explore embedded
              heat-exchange loops for heating.
            </p><p>
              Martian nights can reach around −80°C and below. Useful overnight
              heat delivery, cycling durability and any reduction in electrical
              heating load remain to be measured.
            </p>
          </article>
        </div>
      </details>
      <div class="references">
        <p class="eyebrow">RESEARCH CONTEXT / NOT POPULATION MARS RESULTS</p><p>
          MGS-1 is a Rocknest-based mineralogical analog for basaltic Martian
          regolith, not a substitute for every Mars soil: <a
            href="https://sciences.ucf.edu/class/simulant_marsglobal/"
            >UCF / CLASS MGS-1 reference ↗</a
          >.
        </p><p>
          Direct-solar regolith processing has research precedent, including
          DLR's work on lunar simulants. Those results do not validate this Mars
          system: <a
            href="https://www.dlr.de/en/ff/research-and-transfer/research-infrastructure/high-flux-solar-furnace-and-solar-simulator"
            >DLR high-flux solar furnace ↗</a
          >.
        </p>
      </div>
    </section>

    <section
      class="collaboration-band section"
      id="collaborate"
      aria-labelledby="collaborate-title"
    >
      <div class="shell">
        <p class="eyebrow">05 / WHAT WE NEED HELP WITH</p><h2
          id="collaborate-title"
        >
          THIS IS TOO MULTIDISCIPLINARY<br />FOR ONE PERSON.
        </h2><p class="intro">
          Population Mars is being developed in public because the interesting
          part is not pretending one person already knows the answers. The
          machine crosses optics, ceramics, robotics, controls, computer vision,
          planetary science and construction. If you work in one of these areas,
          there is a real experiment here to improve.
        </p><div class="actions">
          <a href={expertise} class="button primary"
            >CONTRIBUTE EXPERTISE <span aria-hidden="true">↗</span></a
          ><a href={support} class="button"
            >SUPPORT A TEST <span aria-hidden="true">↗</span></a>
        </div><p class="contact-note">
          Both open an email to <a href="mailto:feedback@haidaa.com"
            >feedback@haidaa.com</a
          >. Tell us which experiment you could improve or what testing
          capability you can offer.
        </p><div class="collaborator-grid">
          {
            collaborators.map(([n, title, description]) => (
              <article>
                <>
                  <span class="collaborator-number">{n}</span>
                  <h3>{title}</h3>
