      <div class="shell">
        <div class="log-top">
          <div>
            <p class="eyebrow">12 · Research log</p>
            <h2 id="log-title">Research log.</h2>
          </div>
          <a class="text-link" href="/research/sintering/experiment-record.md" download
            >Experiment-record template ↓</a
          >
        </div>
        <div class="log-entries">
          {
            renderedEntries.map(({ entry, Content }) => (
              <article class="log-entry" id={`log-${entry.slug}`}>
                <header>
                  <div class="log-meta">
                    <span class:list={['tag', entry.data.status]}>
                      {entry.data.status
                        ? statusLabel[entry.data.status]
                        : 'RECORD'}
                    </span>
                    <time datetime={entry.data.pubDate.toISOString()}>
                      {dateFormat.format(entry.data.pubDate)}
                    </time>
                  </div>
                  <h3>{entry.data.title}</h3>
                  <p>{entry.data.description}</p>
                </header>
                {entry.data.videos.length > 0 && (
                  <div class="log-media">
                    {entry.data.videos.map(video => (
                      <figure>
                        <video
                          controls
                          preload="metadata"
                          src={video.src}
                          poster={video.poster}
                        >
                          <a href={video.src}>Download the video</a>
                        </video>
                        {video.caption && (
                          <figcaption>{video.caption}</figcaption>
                        )}
                      </figure>
                    ))}
                  </div>
                )}
                {entry.data.images.length > 0 && (
                  <div class="log-media image-grid">
                    {entry.data.images.map(image => (
                      <figure>
                        <img src={image.src} alt={image.alt} loading="lazy" />
                        {image.caption && (
                          <figcaption>{image.caption}</figcaption>
                        )}
                      </figure>
                    ))}
                  </div>
                )}
                <div class="log-content">
                  <Content />
                </div>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <!-- ================= REFERENCES ================= -->
    <section class="shell section refs" id="references" aria-labelledby="refs-title">
      <p class="eyebrow">References</p>
      <h2 id="refs-title" class="sr-only">References</h2>
      <ol class="ref-list">
