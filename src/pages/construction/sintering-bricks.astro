        }
      </ol>
    </section>

    <!-- ================= CLOSING ================= -->
    <section class="closing section">
      <div class="shell closing-grid">
        <div>
          <p class="eyebrow">Solar regolith paving</p>
          <h2>Help build V1.</h2>
          <p>
