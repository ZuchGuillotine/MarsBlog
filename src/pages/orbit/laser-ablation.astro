---
import BaseLayout from '../../layouts/BaseLayout.astro';
import LaserAblationSim from '../../components/LaserAblationSim';

const parameters = [
  ['Laser', '343 nm frequency-tripled ytterbium, 100 ps pulses, 3.3 kW average ultraviolet output from ~20 kW electrical'],
  ['Pulses', 'Up to 700 J per pulse, 1–30 Hz; energy per pulse set to optimum fluence at the current range, rate set by the 3.3 kW budget'],
  ['Beam director', '1 m silicon-carbide mirror, M² = 1.5; spot diameter 2.44·M²·λ·R/D (0.31 m at 250 km)'],
  ['Coupling', '50 µN·s of impulse per joule on target at optimum fluence (article middle case; 25 and 100 shown as sensitivity), falling linearly to zero at 25 % of optimum fluence'],
  ['Energy on target', 'Pointing efficiency 0.7 × fraction of the spot covered by the target’s projected area; recoil along the beam scaled by a per-body surface-normal efficiency (0.6–0.8)'],
  ['Firing rules', '60–300 km range · beam within 60° of the target’s anti-velocity · approaching targets only (sweeper) · apogee half of eccentric orbits only (shepherd) · laser sunlit'],
  ['Bus', '2.3 t on a 28 kW array; 170 mN argon Hall thruster at 2,500 s with 150 kg propellant, used by the shepherds to hold formation'],
  ['Gravity', 'Point mass plus J2, RK4 at 1 s, six-hour window sampled every 30 s; no drag, radiation pressure, third bodies or attitude dynamics'],
];
---

<BaseLayout
  title="Laser Ablation Campaign | Orbital Observatory"
  description="Three proposed laser-ablation satellites work a fictional debris field: engagement attempts, the orbital changes they cause, success or refusal, and projected de-orbit timelines under approximate physics."
  ogImage="/images/blog/kessler2.png"
  showDonationCTA={false}
>
  <main class="campaign">
    <header class="campaign-hero">
      <div class="kicker"><span></span> Orbital observatory · Simulation</div>
      <h1>Three attack satellites<br /><em>against ten pieces of debris.</em></h1>
      <p>
        This is the debris field from the <a href="https://orbitfleet.populationmars.com/debris" rel="noopener noreferrer">OrbitFleet debris lab</a>
        with the satellites from <a href="/blog/the-case-for-attack-satellites/">The Case for Attack Satellites</a> flying through it.
        Two shepherds hold formation ahead of a derelict spacecraft and a spent stage and fire backwards along the orbit.
        One near-polar sweeper takes head-on shots at whatever crosses within 300 km. Every attempt is logged with the impulse it delivered,
        the orbit change it caused, and what the measured rate projects for reaching a 200 km perigee.
      </p>
      <div class="hero-legend" aria-label="Evidence categories">
        <span><i class="proposed"></i> Proposed spacecraft</span>
        <span><i class="fictional"></i> Fictional debris</span>
        <span><i class="model"></i> Approximate physics, fictional epoch</span>
      </div>
    </header>

    <section class="how-to" aria-label="How to read the simulation">
      <div>
        <p class="eyebrow">Reading it</p>
        <ol>
          <li><strong>Press Play.</strong> At 60× the six-hour window takes six minutes. Shepherd firing shows as violet beams; refused opportunities appear in the log in red.</li>
          <li><strong>Select an engagement</strong> in the log or the timeline strip. The camera follows the satellite and playback slows to real time for sweeper passes, which last seconds.</li>
          <li><strong>Select a debris body</strong> to compare its engaged orbit with the gravity-only baseline and read the projected timeline at three coupling values.</li>
        </ol>
      </div>
      <div>
        <p class="eyebrow">What the rule buys</p>
        <p>
          Ablation pushes a target along the beam, away from the laser. The satellites therefore fire only from ahead, within 60° of the target’s anti-velocity, so recoil lowers energy and perigee.
          The sweeper refuses Fragment H, which it overtakes from behind, because the same laser would raise that orbit. Nothing in the run raises a perigee, and the verification script checks that.
        </p>
      </div>
    </section>

    <LaserAblationSim src="/data/orbits/laser-ablation-scene.json" client:visible />

    <section class="parameters" aria-labelledby="parameters-title">
      <div>
        <p class="eyebrow">Design basis</p>
        <h2 id="parameters-title">Parameters carried from the article</h2>
        <p>
          The scene uses the numbers from sections 6–8 of the article and states where it departs from them. The largest departure is energy on target:
          the article budgets half the beam on target; here the fraction follows the spot size against each body’s projected area, so centimetre-class fragments receive less at long range and heavy bodies receive the full 70 %.
        </p>
      </div>
      <dl>
        {parameters.map(([term, value]) => (
          <div><dt>{term}</dt><dd>{value}</dd></div>
        ))}
      </dl>
    </section>

    <section class="findings" aria-labelledby="findings-title">
      <p class="eyebrow">What the six hours show</p>
      <h2 id="findings-title">Findings within the model</h2>
      <div class="findings-grid">
        <article>
          <h3>Shepherds are steady and slow</h3>
          <p>
            LAS-1 delivers about 0.4 m/s per firing hour to the 600 kg derelict and LAS-2 about 0.17 m/s per firing hour to the 2,000 kg stage.
            Firing only on the apogee half and pausing in eclipse gives a duty near 50 %. Extrapolated, the derelict reaches a 200 km perigee in roughly five weeks and the stage in about two months at 50 µN·s/J, twice that at 25 and half at 100.
          </p>
        </article>
        <article>
          <h3>Formation keeping is cheap</h3>
          <p>
            Lowering a target shortens its period, so it closes on the shepherd ahead of it. The shepherd matches the along-track Δv with its Hall thruster: about 100 g of argon over six hours, so the 150 kg tank covers years of this work.
          </p>
        </article>
        <article>
          <h3>Sweeper passes are seconds long</h3>
          <p>
            Head-on crossings at 10–13 km/s give 10–20 s inside the 300 km sphere. A 10 g insulation flake takes tens of metres per second per pass because its area is a large fraction of the spot; the same pass gives Fragment A, at 100 kg, a hundredth of a metre per second, and the log marks those attempts ineffective.
          </p>
        </article>
        <article>
          <h3>Refusals are part of the design</h3>
          <p>
            The log records every opportunity that entered 300 km without a shot, with the rule that blocked it. Geometry refusals dominate: a target passing beside or below the sweeper would be pushed sideways or forwards, and the operating rule from the article forbids that.
          </p>
        </article>
      </div>
    </section>

    <section class="caveats" aria-labelledby="caveats-title">
      <p class="eyebrow">Fidelity</p>
      <h2 id="caveats-title">What this is not</h2>
      <p>
        No real object is represented; the debris bodies are OrbitFleet’s authored examples plus three added fragments placed so the sweeper meets them.
        The coupling coefficient, threshold and pointing efficiency are assumptions, not measurements. The six-hour integration has no atmosphere; the
        decay tail after a 200 km perigee is a King-Hele estimate with a static atmosphere and can be wrong by several times with solar activity.
        Projected days extrapolate the measured rate linearly and include no scheduling, detection, thermal or availability margin. The builder and its
        verification script live in <code>scripts/orbits/</code> and are documented in <code>docs/laser-ablation-simulation.md</code>.
      </p>
      <p class="back"><a href="/orbit">← Back to the orbital observatory</a></p>
    </section>
  </main>
</BaseLayout>

<style>
  :global(body) { background: #070809; }
  .campaign { --ink:#f3efe8;--muted:#a5a19b;--line:rgba(255,255,255,.12);--mars:#df6b45;--cyan:#75c9d2;--violet:#d9b3ff; min-height:100vh;color:var(--ink);background:radial-gradient(circle at 9% 5%,rgba(120,70,160,.16),transparent 30rem),radial-gradient(circle at 90% 36%,rgba(44,105,117,.12),transparent 34rem),#070809;padding:clamp(3.5rem,6vw,5.5rem) clamp(1rem,3vw,2.5rem) 5rem; }
  .campaign > * { width:min(1480px,100%);margin-inline:auto; }
  .campaign-hero { display:grid;gap:1.2rem;padding-bottom:clamp(2rem,3.5vw,3rem); }
  .kicker { color:#c7b0d8;font:600 .7rem/1.2 ui-monospace,SFMono-Regular,Menlo,monospace;text-transform:uppercase;letter-spacing:.2em; }
  .kicker span { display:inline-block;width:2.75rem;height:1px;margin:0 .8rem .25rem 0;background:var(--violet); }
  .campaign-hero h1 { margin:0;max-width:20ch;color:#e8e4dc;font:600 clamp(2.6rem,5vw,4.4rem)/1.02 Inter,ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;letter-spacing:-.055em; }
  .campaign-hero h1 em { color:var(--violet);font-weight:500;font-style:normal; }
  .campaign-hero > p { margin:0;max-width:52rem;color:#b8b3ac;font-size:clamp(1rem,1.3vw,1.15rem);line-height:1.7; }
  .campaign a { color:var(--cyan); }
  .hero-legend { display:flex;flex-wrap:wrap;gap:.65rem 1.5rem;padding-top:1.1rem;border-top:1px solid var(--line);color:#8f8c87;font:600 .66rem/1 ui-monospace,SFMono-Regular,Menlo,monospace;text-transform:uppercase;letter-spacing:.11em; }
  .hero-legend span { display:inline-flex;align-items:center;gap:.5rem; }
  .hero-legend i { width:.48rem;height:.48rem;border-radius:50%; }
  .proposed { border:1px solid #bb86d9; } .fictional { background:#60d7e5; } .model { background:#8f8c87; }
  .eyebrow { margin:0 0 .5rem;color:#8d8984;font:600 .65rem/1.2 ui-monospace,SFMono-Regular,Menlo,monospace;text-transform:uppercase;letter-spacing:.16em; }
  .how-to { display:grid;grid-template-columns:1.1fr .9fr;gap:1.5rem 3rem;margin-bottom:1.5rem;padding:1.25rem clamp(1rem,2vw,1.75rem);border:1px solid var(--line);background:rgba(255,255,255,.025); }
  .how-to ol { margin:0;padding-left:1.2rem;color:#b8b3ac;font-size:.88rem;line-height:1.6; }
  .how-to li + li { margin-top:.4rem; }
  .how-to p:not(.eyebrow) { margin:0;color:#b8b3ac;font-size:.88rem;line-height:1.65; }
  .how-to strong { color:var(--ink); }
  .parameters { display:grid;grid-template-columns:.8fr 1.2fr;gap:2rem clamp(2rem,5vw,5rem);margin-top:clamp(2.5rem,5vw,4rem);padding-top:clamp(2rem,4vw,3rem);border-top:1px solid var(--line); }
  .parameters h2, .findings h2, .caveats h2 { margin:.3rem 0 .8rem;font:500 clamp(1.6rem,2.6vw,2.4rem)/1.1 Georgia,'Times New Roman',serif;letter-spacing:-.025em; }
  .parameters p:not(.eyebrow), .caveats p:not(.eyebrow) { margin:0;color:#aaa69f;line-height:1.7;font-size:.92rem; }
  .parameters dl { margin:0; }
  .parameters dl div { display:grid;grid-template-columns:8rem 1fr;gap:1rem;padding:.7rem 0;border-bottom:1px solid var(--line); }
  .parameters dt { color:var(--violet);font:600 .66rem/1.5 ui-monospace,SFMono-Regular,Menlo,monospace;text-transform:uppercase;letter-spacing:.1em; }
  .parameters dd { margin:0;color:#c9c4bd;font-size:.84rem;line-height:1.55; }
  .findings { margin-top:clamp(2.5rem,5vw,4rem);padding-top:clamp(2rem,4vw,3rem);border-top:1px solid var(--line); }
  .findings-grid { display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1rem; }
  .findings-grid article { padding:1.2rem 1.3rem;border:1px solid var(--line);background:rgba(255,255,255,.025); }
  .findings-grid h3 { margin:0 0 .5rem;font:500 1.25rem/1.15 Georgia,'Times New Roman',serif; }
  .findings-grid p { margin:0;color:#aaa69f;font-size:.86rem;line-height:1.65; }
  .caveats { margin-top:clamp(2.5rem,5vw,4rem);padding-top:clamp(2rem,4vw,3rem);border-top:1px solid var(--line);max-width:60rem; }
  .caveats code { font:.85em ui-monospace,SFMono-Regular,Menlo,monospace;color:#d8d3cc; }
  .back { margin-top:1.5rem !important; }
  @media (max-width:900px) { .how-to,.parameters { grid-template-columns:1fr; } .findings-grid { grid-template-columns:1fr; } .parameters dl div { grid-template-columns:1fr;gap:.3rem; } }
  @media (max-width:560px) { .campaign { padding-inline:.75rem; } .campaign-hero h1 { font-size:clamp(2.3rem,12vw,4rem); } }
</style>
