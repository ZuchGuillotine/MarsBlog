        <h1>The Case for Attack Satellites</h1>
      </div>
    </header>

    <div class="article-grid">
      <aside class="contents" aria-label="Article sections">
        <p>Contents</p>
        <ol>
          {sections.map(([id, label]) => (
            <li><a href={`#${id}`}>{label}</a></li>
          ))}
        </ol>
