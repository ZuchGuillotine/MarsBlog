---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { blogArticles } from '../../data/blogArticles';
---

<BaseLayout
  title="Blog | Mars Population"
  description="Articles on space infrastructure, engineering, and the systems required for a permanent human future beyond Earth."
  showDonationCTA={false}
  className="blog-index-page"
>
  <section class="blog-index" aria-labelledby="blog-title">
    <header class="blog-heading">
      <p class="eyebrow">Mars Population</p>
      <h1 id="blog-title">Blog</h1>
      <p class="intro">Ideas, systems, and engineering for life beyond Earth.</p>
    </header>

    <div class="article-list">
      {blogArticles.map((article) => (
        <article class="article-card">
          <a class="article-image" href={article.href} aria-label={`Read ${article.title}`}>
            <img
              src={article.image}
              alt={article.imageAlt}
              width="2488"
              height="1384"
              loading="eager"
            />
          </a>

          <div class="article-details">
            <p class="topic">{article.topic}</p>
            <h2><a href={article.href}>{article.title}</a></h2>
            <p class="description">{article.description}</p>
            <a class="read-link" href={article.href}>
              Read article <span aria-hidden="true">→</span>
            </a>
          </div>
        </article>
      ))}
    </div>
  </section>
</BaseLayout>

<style>
  :global(body.blog-index-page),
  :global(.blog-index-page main) {
    background: #f7eeee;
    color: #252022;
  }

  .blog-index {
    width: min(76rem, calc(100% - 2rem));
    margin: 0 auto;
    padding: clamp(3.5rem, 8vw, 7rem) 0 clamp(5rem, 10vw, 9rem);
  }

  .blog-heading {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(16rem, 28rem);
    align-items: end;
    gap: 2rem;
    padding-bottom: clamp(2rem, 5vw, 4rem);
    border-bottom: 1px solid #c8aeb3;
  }

  .eyebrow {
    grid-column: 1 / -1;
    margin: 0 0 -1rem;
    color: #963d45;
    font: 700 0.75rem/1.2 ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  h1 {
    margin: 0;
    color: #211b1d;
    font-family: Georgia, 'Times New Roman', serif;
    font-size: clamp(4.5rem, 12vw, 9rem);
    font-weight: 400;
    line-height: 0.8;
    letter-spacing: -0.07em;
  }

  .intro {
    margin: 0;
    color: #5f5357;
    font-family: Georgia, 'Times New Roman', serif;
    font-size: clamp(1.25rem, 2.5vw, 1.7rem);
    line-height: 1.45;
  }

  .article-list {
    padding-top: clamp(2.5rem, 6vw, 5rem);
  }

  .article-card {
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) minmax(19rem, 0.9fr);
    overflow: hidden;
    background: #fffafa;
    border: 1px solid #d8c4c8;
    box-shadow: 0 1.5rem 4rem rgba(77, 24, 35, 0.09);
  }

  .article-image {
    display: block;
    min-height: 28rem;
    overflow: hidden;
    background: #171315;
  }

  .article-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 350ms ease;
  }

  .article-image:hover img {
    transform: scale(1.015);
  }

  .article-details {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: clamp(2rem, 5vw, 4.5rem);
  }

  .topic {
    margin: 0 0 1.25rem;
    color: #963d45;
    font: 700 0.7rem/1.2 ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  h2 {
    margin: 0;
    color: #211b1d;
    font-family: Georgia, 'Times New Roman', serif;
    font-size: clamp(2.4rem, 5vw, 4.5rem);
    font-weight: 400;
    line-height: 0.96;
    letter-spacing: -0.045em;
  }

  h2 a {
    color: inherit;
    text-decoration: none;
  }

  h2 a:hover,
  h2 a:focus-visible {
    color: #963d45;
  }

  .description {
    margin: 1.75rem 0 2rem;
    color: #51474a;
    font-family: Georgia, 'Times New Roman', serif;
    font-size: 1.05rem;
    line-height: 1.65;
  }

  .read-link {
    align-self: flex-start;
    color: #963d45;
    font: 700 0.8rem/1.2 ui-sans-serif, system-ui, sans-serif;
    letter-spacing: 0.06em;
    text-decoration: none;
    text-transform: uppercase;
  }

  .read-link span {
    display: inline-block;
    margin-left: 0.35rem;
    transition: transform 160ms ease;
  }

  .read-link:hover span {
    transform: translateX(0.25rem);
  }

  a:focus-visible {
    outline: 3px solid rgba(150, 61, 69, 0.65);
    outline-offset: 4px;
  }

  @media (max-width: 820px) {
    .blog-heading,
    .article-card {
      grid-template-columns: 1fr;
    }

    .eyebrow {
      margin-bottom: 0;
    }

    .article-image {
      min-height: clamp(18rem, 65vw, 28rem);
    }
  }

  @media (max-width: 520px) {
    .blog-index {
      width: min(100% - 1.5rem, 76rem);
      padding-top: 3rem;
    }

    h1 {
      font-size: clamp(4rem, 24vw, 6.5rem);
    }

    .article-details {
      padding: 2rem 1.35rem 2.5rem;
    }

    h2 {
      font-size: clamp(2.3rem, 13vw, 3.4rem);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .article-image img,
    .read-link span {
      transition: none;
    }
  }
</style>
