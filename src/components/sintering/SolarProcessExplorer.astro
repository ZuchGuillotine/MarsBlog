---
const stages = [
  {
    name: 'Prepare',
    title: '01 / Prepare a repeatable bed',
    text: 'Collect, screen and meter local material. A screed sets layer depth; a roller establishes controlled green density when the process calls for it.',
  },
  {
    name: 'Process',
    title: '02 / Regulate the thermal input',
    text: 'Tracking, aperture and focus control deliver heat to a small zone. Adjust power and motion to reach a target sinter or partial-melt state.',
  },
  {
    name: 'Cool',
    title: '03 / Manage the cooling wake',
    text: 'The active spot stays small. The bonded track behind it passes through a temperature gradient; shields and scan strategy manage cooling and thermal stress.',
  },
  {
    name: 'Inspect',
    title: '04 / Inspect before handling',
    text: 'Pyrometry, thermal imaging and visible inspection inform acceptance. A compact arm can handle a cooled part, position a sensor or remove a reject.',
  },
  {
    name: 'Integrate',
    title: '05 / Build the process. Measure it. Automate what works.',
    text: 'V1: manual solar material tests. V2: closed-loop solar CNC. V3: an autonomous construction cell. Survey, prepare, process, inspect, place and verify.',
  },
];
---

<div class="explorer" data-solar-explorer>
  <div class="explorer-header">
    <span>THERMAL PROCESS / SCHEMATIC WALKTHROUGH</span><span
      >15 SEC · ILLUSTRATIVE, NOT A SIMULATION</span>
  </div>
  <div class="process-scene" aria-hidden="true">
    <svg viewBox="0 0 1000 310" xmlns="http://www.w3.org/2000/svg">
      <defs>
        <pattern
          id="solar-grid"
          width="25"
          height="25"
          patternUnits="userSpaceOnUse"
          ><path
            d="M25 0H0V25"
            fill="none"
            stroke="#4d5b42"
            stroke-width=".5"
            opacity=".35"></path></pattern
        >
        <pattern
          id="solar-grains"
          width="16"
          height="15"
          patternUnits="userSpaceOnUse"
          ><circle cx="3" cy="4" r="1.6" fill="#7c745c"></circle><circle
            cx="11"
            cy="11"
            r="1"
            fill="#8c8367"></circle></pattern
        >
        <linearGradient id="solar-wake"
          ><stop stop-color="#59634c"></stop><stop
            offset=".55"
            stop-color="#92503c"></stop><stop offset=".88" stop-color="#e78644"
          ></stop><stop offset="1" stop-color="#ffe3a5"></stop></linearGradient
        >
        <radialGradient id="solar-spot"
          ><stop stop-color="#fff9d7"></stop><stop
            offset=".3"
            stop-color="#ffdb8d"></stop><stop
            offset=".7"
            stop-color="#e5984d"
            stop-opacity=".5"></stop><stop
            offset="1"
            stop-color="#e5984d"
            stop-opacity="0"></stop></radialGradient
        >
      </defs>
      <rect width="1000" height="310" fill="url(#solar-grid)"></rect>
      <g class="preparation" data-part="0"
        ><rect
          x="55"
          y="98"
          width="255"
          height="155"
          fill="url(#solar-grains)"
          stroke="#5d654d"></rect><path
          d="M143 93V258L157 249V102Z"
          fill="#acaa91"
          stroke="#ddd6b2"></path><rect
          x="209"
          y="107"
          width="28"
          height="138"
          rx="7"
          fill="#6e7760"
          stroke="#b1b599"></rect><path
          d="M208 131H237M208 220H237"
          stroke="#c3c3a7"></path><path
          d="M69 277H274m-7-5 7 5-7 5"
          fill="none"
          stroke="#b7bb98"></path><text x="55" y="70"
          >01 / PREPARE + COMPACT</text
        ></g
      >
      <g data-part="1"
        ><rect
          x="333"
          y="98"
          width="382"
          height="155"
          fill="#343c2c"
          stroke="#697456"></rect><g stroke="#748061" stroke-width="9"
          ><path
            d="M350 120H697M350 143H697M350 166H697M350 212H697M350 235H697"
          ></path></g
        ><path d="M325 89H726M325 263H726" stroke="#a8af95" stroke-width="3"
        ></path><path
          d="M345 84V94M701 84V94M345 258V268M701 258V268"
          stroke="#ccd0b6"
          stroke-width="5"></path><text x="333" y="70"
          >02 / CONTROLLED SOLAR INPUT</text
        ></g
      >
      <g data-part="2"
        ><rect
          x="352"
          y="181"
          width="183"
          height="16"
          rx="3"
          fill="url(#solar-wake)"
          data-wake></rect><path
          d="M372 176V202H451V176"
          fill="#68715b"
          fill-opacity=".5"
          stroke="#a1a88d"
          stroke-dasharray="4 3"></path><text x="349" y="294"
          >03 / COOLING WAKE</text
        ></g
      >
      <g data-head transform="translate(535 0)"
        ><path
          d="M0 94V159"
          stroke="#c2c9ad"
          stroke-width="1"
          stroke-dasharray="4 4"></path><circle
          cx="0"
          cy="189"
          r="24"
          fill="url(#solar-spot)"></circle><circle
          cx="0"
          cy="189"
          r="4"
          fill="#fff2cc"></circle><path
          d="M-11 81V96H11V81"
          fill="#8f997a"
          stroke="#c4c9b0"></path></g
      >
      <g data-part="3"
        ><path d="M765 110H932V255H765Z" fill="#252f24" stroke="#6f7e5b"
        ></path><rect
          x="789"
          y="135"
          width="52"
          height="43"
          fill="#7a8269"
          stroke="#aab494"></rect><rect
          x="856"
          y="135"
          width="52"
          height="43"
          fill="#7a8269"
          stroke="#aab494"></rect><rect
          x="789"
          y="191"
          width="52"
          height="43"
          fill="#7a8269"
          stroke="#aab494"></rect><rect
