          d="M860 102L906 60 934 94 896 131"
          fill="none"
          stroke="#abb49b"
          stroke-width="9"
          stroke-linejoin="round"></path><circle
          cx="860"
          cy="102"
          r="15"
          fill="#394732"
          stroke="#c7ceb8"></circle><circle
          cx="906"
          cy="60"
          r="7"
          fill="#d0d4bd"></circle><path
          d="M885 132V141H905V132"
          fill="none"
          stroke="#d0d4bd"
          stroke-width="3"></path><path
          d="M762 38H803V61H762Z"
          fill="#85916f"
          stroke="#bec9a8"></path><circle cx="775" cy="49" r="5" fill="#1b231a"
        ></circle><path
          d="M774 62 690 167"
          fill="none"
          stroke="#acbb8c"
          stroke-dasharray="4 5"></path><text x="765" y="294"
          >04 / INSPECT + HANDLE</text
        ></g
      >
    </svg>
  </div>
  <div class="scene-legend">
    <span><i class="hot"></i> Active spot</span><span
      ><i class="warm"></i> Hot track</span
    ><span><i class="cool"></i> Cooling material</span><span
      ><i class="done"></i> Consolidated surface</span>
  </div>
  <div class="walkthrough-controls" hidden>
    <button
      type="button"
      data-play
      aria-label="Play the 15-second process walkthrough"
      >PLAY 15-SECOND WALKTHROUGH <span aria-hidden="true">▶</span></button
    ><div
      class="progress-track"
      role="progressbar"
      aria-label="Walkthrough progress"
      aria-valuemin="0"
      aria-valuemax="15"
      aria-valuenow="0"
    >
      <span data-progress></span>
    </div><span data-time>00 / 15</span>
  </div>
  <div
    class="stage-buttons"
    hidden
    role="group"
    aria-label="Explore process stages"
  >
    {
      stages.map((s, i) => (
        <button
          type="button"
          data-stage={i}
          aria-pressed={i === 0 ? 'true' : 'false'}
        >
          <span>0{i + 1}</span> {s.name}
        </button>
      ))
    }
  </div>
  <div class="stage-caption" aria-live="polite" aria-atomic="true">
    {
      stages.map((s, i) => (
        <div data-caption={i} hidden={i !== 0}>
          <>
            <h3>{s.title}</h3>
            <p>{s.text}</p>
          </>
        </div>
      ))
    }
  </div>
  <p class="schematic-note">
    Conceptual sequence only. Colors, timing, spot travel and geometry explain
    the operations; they are not measured temperatures, real-time telemetry or
    an optical / thermal model. No automatic playback.
  </p>
  <noscript
    ><p class="schematic-note">
      JavaScript is off. The complete static material flow and feedback loop are
      shown below.
    </p></noscript
  >
</div>
<script>
  const root = document.querySelector<HTMLElement>('[data-solar-explorer]');
  if (root) {
    const play = root.querySelector<HTMLButtonElement>('[data-play]')!;
    const progress = root.querySelector<HTMLElement>('[data-progress]')!;
    const bar = root.querySelector<HTMLElement>('[role="progressbar"]')!;
    const time = root.querySelector<HTMLElement>('[data-time]')!;
    const head = root.querySelector<SVGGElement>('[data-head]')!;
    const wake = root.querySelector<SVGRectElement>('[data-wake]')!;
    const buttons = Array.from(
      root.querySelectorAll<HTMLButtonElement>('[data-stage]')
    );
    const captions = Array.from(
      root.querySelectorAll<HTMLElement>('[data-caption]')
    );
    const parts = Array.from(root.querySelectorAll<SVGGElement>('[data-part]'));
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    let elapsed = 0;
    let playing = false;
    let previous = 0;
    let frame = 0;
    let active = -1;
    root
      .querySelectorAll<HTMLElement>('.walkthrough-controls, .stage-buttons')
      .forEach(el => {
        el.hidden = false;
      });
    function paint() {
      const stage = Math.min(4, Math.floor(elapsed / 3000));
      if (stage !== active) {
        active = stage;
        buttons.forEach((b, i) =>
          b.setAttribute('aria-pressed', String(i === stage))
        );
        captions.forEach((c, i) => {
          c.hidden = i !== stage;
        });
        parts.forEach((p, i) => {
          p.style.opacity = stage === 4 || i === stage ? '1' : '.42';
        });
      }
      // Explanatory motion only: no temperatures or physical rates are inferred.
      const x = reducedMotion.matches
        ? 535
        : 510 + Math.max(0, Math.min(1, (elapsed - 3000) / 6000)) * 145;
      head.setAttribute('transform', `translate(${x} 0)`);
      head.style.opacity =
        stage === 1 || stage === 2 || stage === 4 ? '1' : '.35';
      wake.setAttribute('width', String(x - 352));
      progress.style.width = `${elapsed / 150}%`;
      bar.setAttribute('aria-valuenow', String(Math.floor(elapsed / 1000)));
      time.textContent = `${String(Math.floor(elapsed / 1000)).padStart(2, '0')} / 15`;
    }
    function updateButton() {
      const label = playing
        ? 'PAUSE WALKTHROUGH'
        : elapsed >= 15000
          ? 'REPLAY WALKTHROUGH'
          : elapsed > 0
            ? 'RESUME WALKTHROUGH'
            : 'PLAY 15-SECOND WALKTHROUGH';
      play.textContent = `${label} ${playing ? 'Ⅱ' : '▶'}`;
      play.setAttribute('aria-label', label.toLowerCase());
    }
    function pause() {
      playing = false;
      cancelAnimationFrame(frame);
      updateButton();
    }
    function tick(now: number) {
      if (!playing) return;
      elapsed = Math.min(15000, elapsed + now - previous);
      previous = now;
      paint();
      if (elapsed >= 15000) {
        pause();
        return;
      }
      frame = requestAnimationFrame(tick);
    }
    play.addEventListener('click', () => {
      if (playing) {
        pause();
        return;
      }
      if (elapsed >= 15000) elapsed = 0;
      playing = true;
      previous = performance.now();
      updateButton();
      paint();
      frame = requestAnimationFrame(tick);
    });
    buttons.forEach((b, i) =>
      b.addEventListener('click', () => {
        pause();
        elapsed = i * 3000;
        paint();
        updateButton();
      })
    );
    document.addEventListener('visibilitychange', () => {
      if (document.hidden && playing) pause();
    });
    new IntersectionObserver(
      entries => {
        if (!entries[0].isIntersecting && playing) pause();
      },
      { threshold: 0 }
    ).observe(root);
    reducedMotion.addEventListener('change', () => {
      pause();
      paint();
    });
    paint();
  }
</script>
