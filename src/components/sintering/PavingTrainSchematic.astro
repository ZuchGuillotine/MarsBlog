---
// Side-elevation cutaway of the five-car solar paving train (V3 concept),
// with the design-target temperature profile drawn on the same x-axis.
// Drawn in inline SVG; 1970s technical-cutaway conventions: thin off-white
// leader lines, numbered stations, phantom (dashed) lines for parts cut away.
import { stations } from '../../data/solarPaving';

// Temperature axis: 0 °C at y=610, 1,500 °C at y=450.
const ty = (t: number) => +(610 - t * (160 / 1500)).toFixed(1);

// Car x-ranges (px in the 1400-wide drawing)
const cars = [130, 360, 590, 820, 1050].map(x0 => ({ x0, x1: x0 + 210 }));
const stationX = [104, 465, 700, 905, 1190];

// Temperature profile along the train (design targets)
const profile: [number, number][] = [
  [60, 20],
  [340, 20],
  [372, 160],
  [420, 600],
  [480, 850],
  [560, 1000],
  [612, 1060],
  [665, 1320],
  [700, 1450],
  [735, 1320],
  [790, 1190],
  [880, 1130],
  [960, 1100],
  [1045, 1100],
  [1330, 900],
  [1352, 700],
  [1392, 420],
];
const profilePath = profile
  .map(([x, t], i) => `${i ? 'L' : 'M'}${x} ${ty(t)}`)
  .join(' ');
const bare: [number, number][] = [
  [1045, 1100],
  [1062, 760],
  [1090, 480],
  [1130, 290],
  [1180, 190],
];
const barePath = bare.map(([x, t], i) => `${i ? 'L' : 'M'}${x} ${ty(t)}`).join(' ');

// Dish: off-axis mirror on a slanted mast, face normal pointing at the pool.
const D = { x: 610, y: 130 };
const nrm = { x: 0.968, y: 0.252 }; // face normal (towards the pool side)
const tan = { x: -0.252, y: 0.968 };
const half = 95;
const sag = 30;
const A = { x: D.x - half * tan.x, y: D.y - half * tan.y }; // upper rim
const B = { x: D.x + half * tan.x, y: D.y + half * tan.y }; // lower rim
const apex = { x: D.x - sag * nrm.x, y: D.y - sag * nrm.y };
const C = { x: 2 * apex.x - (A.x + B.x) / 2, y: 2 * apex.y - (A.y + B.y) / 2 };
const bez = (t: number) => ({
  x: (1 - t) ** 2 * A.x + 2 * (1 - t) * t * C.x + t * t * B.x,
  y: (1 - t) ** 2 * A.y + 2 * (1 - t) * t * C.y + t * t * B.y,
});
const f = (n: number) => n.toFixed(1);
const dishPath = `M${f(A.x)} ${f(A.y)}Q${f(C.x)} ${f(C.y)} ${f(B.x)} ${f(B.y)}`;
const backC = { x: C.x - 16 * nrm.x, y: C.y - 16 * nrm.y };
const dishBack = `M${f(A.x)} ${f(A.y)}Q${f(backC.x)} ${f(backC.y)} ${f(B.x)} ${f(B.y)}`;
const dishShell = `${dishPath}Q${f(backC.x)} ${f(backC.y)} ${f(A.x)} ${f(A.y)}Z`;
const pivot = { x: D.x - 48 * nrm.x, y: D.y - 48 * nrm.y };
const facets = [0.125, 0.25, 0.375, 0.5, 0.625, 0.75, 0.875].map(t => {
  const p = bez(t);
  return `M${f(p.x)} ${f(p.y)}l${f(-9 * nrm.x)} ${f(-9 * nrm.y)}`;
});
const rays = [0.18, 0.5, 0.82].map(t => {
  const p = bez(t);
  return `M${f(p.x + 96 * 0.8)} ${f(p.y - 96 * 0.6)}L${f(p.x)} ${f(p.y)}`;
});
const iris = `M${f(A.x)} ${f(A.y)}l${f(-13 * tan.x)} ${f(-13 * tan.y)}M${f(B.x)} ${f(B.y)}l${f(13 * tan.x)} ${f(13 * tan.y)}`;
const cone = `${f(A.x)},${f(A.y)} ${f(B.x)},${f(B.y)} 700,336`;
const faceLabel = bez(0.3);

// Scattered cobbles in the windrow (deterministic)
const cobbles = Array.from({ length: 46 }, (_, i) => {
  const x = 150 + i * 11.6 + ((i * 37) % 7);
  const r = 3 + ((i * 13) % 4);
  const y = 338 - r * 0.7 - ((i * 5) % 3);
  return { x: +x.toFixed(1), y: +y.toFixed(1), r };
});
// Loose rocks ahead of the train
const loose = [18, 44, 63, 82].map((x, i) => ({ x, r: 3 + (i % 3) }));
// Contraction joints behind the screed
const joints = [958, 1022, 1086, 1150, 1214, 1278, 1342];
---

<figure class="train" aria-labelledby="train-caption">
  <div class="train-scroll" tabindex="0" aria-label="Paving train cutaway drawing (scrolls sideways on small screens)">
    <svg
      viewBox="0 0 1400 640"
      xmlns="http://www.w3.org/2000/svg"
      role="img"
      aria-labelledby="train-title train-desc"
    >
      <title id="train-title">Solar regolith paving train, side-elevation cutaway</title>
      <desc id="train-desc">
        Five linked rovers travel left. 01 grade: a blade windrows coarse rock. 02 preheat and degas under a
        reflective hood at 600 to 1000 °C. 03 melt: a faceted dish with an iris aperture focuses sunlight on
        the rock to form a pool at about 1450 °C while preheated fines are metered in. 04 screed: a boron
        nitride paddle spreads the 1000 to 1200 °C mush, presses grooves and scores joints. 05 anneal: a
        polished hood slows cooling from 1100 to 900 °C. A temperature graph below follows the same stations.
      </desc>
      <defs>
        <pattern id="pt-fines" width="9" height="7" patternUnits="userSpaceOnUse">
          <circle cx="2" cy="2" r=".8" fill="#6f6a5c"></circle>
          <circle cx="6.5" cy="5" r=".6" fill="#5b574b"></circle>
        </pattern>
        <pattern id="pt-hatch" width="6" height="6" patternUnits="userSpaceOnUse" patternTransform="rotate(45)">
          <path d="M0 0V6" stroke="#d9d6c8" stroke-width=".6" opacity=".45"></path>
        </pattern>
        <linearGradient id="pt-ribbon" gradientUnits="userSpaceOnUse" x1="690" y1="0" x2="1400" y2="0">
          <stop offset="0" stop-color="#fff1c9"></stop>
          <stop offset=".08" stop-color="#ffb35c"></stop>
          <stop offset=".3" stop-color="#e2733a"></stop>
          <stop offset=".55" stop-color="#b24a2c"></stop>
          <stop offset=".86" stop-color="#6e3325"></stop>
          <stop offset="1" stop-color="#34302c"></stop>
        </linearGradient>
        <linearGradient id="pt-cone" gradientUnits="userSpaceOnUse" x1="610" y1="60" x2="700" y2="336">
          <stop offset="0" stop-color="#ffe6b5" stop-opacity=".08"></stop>
          <stop offset="1" stop-color="#ffd48a" stop-opacity=".55"></stop>
        </linearGradient>
        <radialGradient id="pt-pool">
          <stop offset="0" stop-color="#fffbe8"></stop>
          <stop offset=".45" stop-color="#ffd48a"></stop>
          <stop offset="1" stop-color="#ff8a3d" stop-opacity="0"></stop>
        </radialGradient>
        <marker id="pt-arrow" viewBox="0 0 8 8" refX="4" refY="4" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
          <path d="M0 0L8 4L0 8Z" fill="#d9d6c8"></path>
        </marker>
      </defs>

      <!-- Title block -->
      <g class="t-caps">
        <text x="20" y="28" class="t-strong">SOLAR REGOLITH PAVER · V3 CONCEPT</text>
        <text x="20" y="46">SIDE ELEVATION · NEAR-SIDE RAILS CUT AWAY · NOT TO SCALE</text>
        <path d="M110 70H24" stroke="#d9d6c8" stroke-width="1" marker-end="url(#pt-arrow)"></path>
        <text x="120" y="74">DIRECTION OF TRAVEL</text>
      </g>

      <!-- Line legend -->
      <g class="t-caps t-small">
        <rect x="1060" y="20" width="330" height="98" class="legend-box"></rect>
        <path d="M1076 42H1116" class="ln"></path>
        <text x="1128" y="46">NEAR SIDE</text>
        <path d="M1076 62H1116" class="ln phantom"></path>
        <text x="1128" y="66">CUT AWAY / HIDDEN</text>
        <path d="M1076 82H1116" class="dash-fines"></path>
        <text x="1128" y="86">PREHEATED FINES PATH</text>
        <text x="1076" y="106">DISH ~4 m · WHEELS STRADDLE LANE</text>
      </g>

      <!-- Ground: subgrade cutaway -->
      <rect x="0" y="340" width="1400" height="54" fill="url(#pt-fines)"></rect>
      <path d="M0 340H1400" class="ln"></path>
      <path d="M0 394H1400" class="ln faint" stroke-dasharray="2 5"></path>

      <!-- Loose rocks ahead of the blade -->
      {loose.map(r => <circle cx={r.x} cy={340 - r.r * 0.6} r={r.r} class="rock"></circle>)}

      <!-- Windrow of coarse rock (preheated under car 2) -->
      <g>
        {
          cobbles.map(c => (
            <circle
              cx={c.x}
              cy={c.y}
              r={c.r}
              class:list={['rock', { warm: c.x > 372 && c.x < 560, hot: c.x >= 560 }]}
            ></circle>
          ))
        }
      </g>

      <!-- Paved ribbon: pool → mush → finished layer (5 cm target) -->
      <path d="M690 336H1400V358H690Z" fill="url(#pt-ribbon)"></path>
      <path
        d={`M940 336 ${Array.from({ length: 57 }, (_, i) => `L${944 + i * 8} ${i % 2 ? 336 : 333.6}`).join(' ')}`}
        class="ln thin"
        fill="none"
      ></path>
      {
        joints.map(x => (
          <g>
            <path d={`M${x - 3} 333L${x} 339L${x + 3} 333`} class="ln thin" fill="none"></path>
            <path d={`M${x} 339V358`} class="ln thin" stroke-dasharray="2 2"></path>
          </g>
        ))
      }
      <ellipse cx="700" cy="338" rx="34" ry="11" fill="url(#pt-pool)" class="pool"></ellipse>

      <!-- Couplers -->
      {
        [340, 570, 800, 1030].map(x => (
          <g>
            <path d={`M${x} 292H${x + 20}`} class="ln"></path>
            <circle cx={x + 10} cy="292" r="3" class="pin"></circle>
          </g>
        ))
      }

      <!-- Car bodies -->
      <g class="car">
        <!-- Car 1 -->
        <rect x="130" y="262" width="210" height="44"></rect>
        <path d="M150 262V250H230V262Z" class="cab"></path>
        <!-- Car 2 with fines hopper -->
        <rect x="360" y="262" width="210" height="44"></rect>
        <path d="M470 262L478 232H530L538 262Z" class="cab"></path>
        <!-- Car 3: front mast box + rear box; near-side rails cut away -->
        <rect x="590" y="262" width="30" height="44"></rect>
        <rect x="760" y="262" width="40" height="44"></rect>
        <path d="M620 266H760M620 302H760" class="ln phantom"></path>
        <!-- Car 4 -->
        <rect x="820" y="262" width="210" height="44"></rect>
        <!-- Car 5 -->
        <rect x="1050" y="262" width="210" height="44"></rect>
      </g>

      <!-- Wheels: near-side solid, middle axle phantom -->
      {
        cars.map(c => (
          <g>
            <circle cx={c.x0 + 32} cy="324" r="16" class="wheel"></circle>
            <circle cx={c.x0 + 105} cy="324" r="16" class="wheel phantom"></circle>
            <circle cx={c.x1 - 32} cy="324" r="16" class="wheel"></circle>
            <circle cx={c.x0 + 32} cy="324" r="3" class="pin"></circle>
            <circle cx={c.x1 - 32} cy="324" r="3" class="pin"></circle>
          </g>
        ))
      }

      <!-- 01 GRADE: blade + rake -->
      <path d="M130 290L114 298" class="ln thick"></path>
      <path d="M116 290Q98 314 106 342" class="tool" fill="none"></path>
      <path d="M195 306V330M210 306V330M225 306V330M240 306V330M255 306V330" class="ln thin"></path>

      <!-- 02 PREHEAT: reflective hood over windrow + vents -->
      <path d="M372 306L380 330H552L560 306" fill="url(#pt-hatch)" class="ln"></path>
      <g class="vent">
        <path d="M412 258C406 248 418 240 412 230S418 214 412 206"></path>
        <path d="M442 258C436 248 448 240 442 230S448 214 442 206"></path>
      </g>
      <!-- Preheated fines: tray to chute into the pool -->
      <path d="M504 262V300H566L690 334" class="ln dash-fines" fill="none"></path>

      <!-- 03 MELT: faceted dish on slanted mast, iris at rim, flux cone -->
      <polygon points={cone} fill="url(#pt-cone)" class="cone"></polygon>
      <path d={`M${f(A.x)} ${f(A.y)}L700 336M${f(B.x)} ${f(B.y)}L700 336`} class="ln faint" fill="none"></path>
      <path d={`M606 262L${f(pivot.x)} ${f(pivot.y)}`} class="ln thick"></path>
      <path
        d={`M${f(pivot.x)} ${f(pivot.y)}L${f(A.x)} ${f(A.y)}M${f(pivot.x)} ${f(pivot.y)}L${f(B.x)} ${f(B.y)}`}
        class="ln thin"
        fill="none"
      ></path>
      <path d={dishShell} class="dish-shell"></path>
      <path d={dishBack} class="ln thin" fill="none"></path>
      <path d={dishPath} class="dish" fill="none"></path>
      <path d={facets.join('')} class="ln thin" fill="none"></path>
      <path d={iris} class="iris"></path>
      <circle cx={f(pivot.x)} cy={f(pivot.y)} r="5" class="pin"></circle>
      <g class="ray">{rays.map(r => <path d={r}></path>)}</g>
      <text x={f(A.x + 110)} y="18" class="t-caps">SUN</text>

      <!-- 04 SCREED: BN paddle + joint scorer -->
      <path d="M862 306L884 328" class="ln thick"></path>
      <path d="M876 328H934L938 336H874Z" class="bn"></path>
      <path d="M958 306V341" class="ln thick"></path>
      <circle cx="958" cy="318" r="6" class="pin"></circle>

      <!-- 05 ANNEAL: long polished hood with radiation arrows -->
      <path d="M1044 306V318Q1048 331 1060 331H1330L1338 318" fill="none" class="hood"></path>
      <path d="M1060 327H1328" class="ln thin"></path>
      <g class="rad">
        <path d="M1110 336L1118 329L1126 336"></path>
        <path d="M1180 336L1188 329L1196 336"></path>
        <path d="M1250 336L1258 329L1266 336"></path>
      </g>

      <!-- In-drawing labels with leader lines -->
      <g class="t-caps">
        <path d={`M488 96H${f(faceLabel.x - 4)}`} class="ln leader"></path>
        <text x="484" y="100" text-anchor="end">FACETED DISH</text>
        <path d={`M488 26H${f(A.x - 13 * tan.x - 4)}`} class="ln leader"></path>
        <text x="484" y="30" text-anchor="end">IRIS APERTURE</text>
        <path d="M672 196H712" class="ln leader"></path>
        <text x="718" y="200">FLUX CONE</text>
        <text x="250" y="198">VENT H₂O · O₂/HCl · SO₂</text>
        <path d="M488 222L500 232" class="ln leader"></path>
        <text x="484" y="224" text-anchor="end">FINES HOPPER</text>
        <path d="M1300 252V322" class="ln leader"></path>
        <text x="1392" y="232" text-anchor="end">POLISHED HOOD</text>
        <text x="1392" y="248" text-anchor="end">CUTS RADIATIVE LOSS</text>
        <text x="836" y="248">BN PADDLE · JOINT SCORER</text>
        <path d="M905 252V326M958 252V300" class="ln leader"></path>
      </g>
      <g class="t-caps t-small">
        <rect x="1108" y="366" width="182" height="18" class="label-bg"></rect>
        <text x="1114" y="379">JOINTS EVERY 0.5–1 m</text>
        <rect x="746" y="366" width="230" height="18" class="label-bg"></rect>
        <text x="752" y="379">PAVED LAYER · 5 cm TARGET</text>
        <rect x="8" y="366" width="226" height="18" class="label-bg"></rect>
        <text x="14" y="379">SUBGRADE · COMPACTED REGOLITH</text>
        <rect x="236" y="366" width="170" height="18" class="label-bg"></rect>
        <text x="242" y="379">WINDROW · COARSE ROCK</text>
      </g>

      <!-- Station callouts -->
      {
        stationX.map((x, i) => (
          <g class="callout">
            <path d={`M${x} 400V${412}`} class="ln leader"></path>
            <circle cx={x} cy="422" r="11"></circle>
            <text x={x} y="426" text-anchor="middle">{stations[i].n}</text>
            <text x={x + 17} y="426" class="t-caps t-strong">
              {stations[i].name.toUpperCase()}
            </text>
          </g>
        ))
      }

      <!-- Temperature profile (design targets) -->
      <g class="graph">
        <rect x="372" y={ty(1000)} width="188" height={ty(600) - ty(1000)} class="band"></rect>
        <rect x="880" y={ty(1200)} width="120" height={ty(1000) - ty(1200)} class="band"></rect>
        <rect x="1045" y={ty(1100)} width="285" height={ty(900) - ty(1100)} class="band window"></rect>
        {
          [0, 500, 1000, 1500].map(t => (
            <g>
              <path d={`M60 ${ty(t)}H1392`} class="grid"></path>
              <text x="54" y={ty(t) + 3} text-anchor="end" class="t-caps t-small">
                {t.toLocaleString('en-US')}
              </text>
            </g>
          ))
        }
        {stationX.map(x => <path d={`M${x} 440V610`} class="grid" stroke-dasharray="2 4"></path>)}
        <path d={barePath} class="bare"></path>
        <path d={profilePath} class="curve"></path>
        <circle cx="700" cy={ty(1450)} r="3.5" class="peak"></circle>
      </g>
      <g class="t-caps t-small">
        <text x="20" y="444">°C</text>
        <text x="712" y={ty(1450) - 4}>POOL ~1,400–1,450</text>
        <text x="378" y={ty(1000) - 5}>PREHEAT 600–1,000</text>
        <text x="886" y={ty(1200) - 5}>SCREED 1,000–1,200</text>
        <text x="1188" y={ty(1100) - 5}>SLOW COOL 1,100→900</text>
        <text x="1096" y={ty(430)}>NO HOOD: QUENCH → GLASS</text>
        <text x="1392" y="632" text-anchor="end">TEMPERATURE PROFILE · DESIGN TARGETS</text>
        <text x="60" y="632">AMBIENT</text>
      </g>
    </svg>
  </div>
  <p class="scroll-hint" aria-hidden="true">Scroll sideways to see the whole train →</p>
  <figcaption id="train-caption">
    <ol class="station-key">
      {
        stations.map(s => (
          <li>
            <span class="key-n">{s.n}</span>
            <div>
              <h3>{s.name}</h3>
              <p class="key-t">{s.temp}</p>
              <p>{s.text}</p>
            </div>
          </li>
        ))
      }
    </ol>
  </figcaption>
</figure>

<style>
  .train {
    margin: 0;
    border: 1px solid #4a4d43;
    background: #131715;
  }
  .train-scroll {
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scrollbar-width: thin;
  }
  .train-scroll:focus-visible {
    outline: 2px solid #efb86a;
    outline-offset: -2px;
  }
  .train svg {
    display: block;
    width: 100%;
    min-width: 900px;
    height: auto;
  }
  .train text {
    font-family: 'JetBrains Mono', monospace;
    font-size: 11px;
    fill: #d9d6c8;
    letter-spacing: 0.06em;
  }
  .train .t-strong {
    fill: #efb86a;
    font-weight: 600;
  }
  .train .t-small {
    font-size: 10px;
  }
  .train .t-small text {
    font-size: 10px;
  }
  .ln {
    stroke: #d9d6c8;
    stroke-width: 1;
  }
  .ln.thin {
    stroke-width: 0.8;
  }
  .ln.thick {
    stroke-width: 3;
  }
  .ln.faint {
    opacity: 0.45;
  }
  .ln.leader {
    stroke-width: 0.7;
    opacity: 0.8;
  }
  .ln.phantom {
    stroke-dasharray: 6 4;
    opacity: 0.6;
  }
  .car rect {
    fill: #262a26;
    stroke: #d9d6c8;
    stroke-width: 1;
  }
  .wheel {
    fill: #1b1f1c;
    stroke: #d9d6c8;
    stroke-width: 1;
  }
  .wheel.phantom {
    fill: none;
    stroke-dasharray: 4 3;
    opacity: 0.55;
  }
  .pin {
    fill: #131715;
    stroke: #d9d6c8;
    stroke-width: 1;
  }
  .rock {
    fill: #57534a;
    stroke: #8d887a;
    stroke-width: 0.6;
  }
  .rock.warm {
    fill: #8a4a2c;
    stroke: #d2703a;
  }
  .rock.hot {
    fill: #d2703a;
    stroke: #ffb35c;
  }
  .tool {
    stroke: #d9d6c8;
    stroke-width: 4;
    stroke-linecap: round;
  }
  .dish {
    stroke: #f2efe3;
    stroke-width: 3.5;
  }
  .dish-shell {
    fill: #3a3d37;
    stroke: none;
  }
  .cab {
    fill: #262a26;
    stroke: #d9d6c8;
    stroke-width: 1;
  }
  .iris {
    stroke: #0b0d0c;
    stroke-width: 8;
    stroke-linecap: butt;
    fill: none;
  }
  .ray path {
    stroke: #ffe6b5;
    stroke-width: 1;
    opacity: 0.7;
    stroke-dasharray: 5 4;
  }
  .cone {
    stroke: none;
  }
  .bn {
    fill: #efeadb;
    stroke: #d9d6c8;
  }
  .hood {
    stroke: #e9e6dc;
    stroke-width: 3;
  }
  .rad path {
    fill: none;
    stroke: #ffb35c;
    stroke-width: 1;
  }
  .vent path {
    fill: none;
    stroke: #b6b6ad;
    stroke-width: 1;
    stroke-dasharray: 3 3;
  }
  .dash-fines {
    stroke-dasharray: 1.5 3;
    stroke-width: 2;
    stroke: #e2733a;
    stroke-linecap: round;
  }
  .legend-box {
    fill: none;
    stroke: #3c3e38;
  }
  .label-bg {
    fill: #131715;
    opacity: 0.85;
  }
  .callout circle {
    fill: #131715;
    stroke: #efb86a;
    stroke-width: 1.2;
  }
  .callout > text:first-of-type {
    fill: #efb86a;
    font-size: 10px;
  }
  .graph .grid {
    stroke: #3c3e38;
    stroke-width: 1;
  }
  .graph .band {
    fill: #efb86a;
    opacity: 0.1;
  }
  .graph .band.window {
    fill: url(#pt-hatch);
    opacity: 1;
  }
  .graph .curve {
    fill: none;
    stroke: #efb86a;
