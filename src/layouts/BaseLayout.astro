---
import '../styles/global.css';
import NewsletterSignup from '../components/NewsletterSignup.astro';
import { SITE_EMAIL, SITE_NAME } from '../data/site';

export interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  showDonationCTA?: boolean;
  className?: string;
  preloadGlobeTexture?: boolean;
  noindex?: boolean;
}

const {
  title,
  description = "Explore where we could settle on Mars, how we could build there, and what it would take to make the planet habitable.",
  ogImage,
  showDonationCTA = true,
  className = "",
  preloadGlobeTexture = false,
  noindex = false
} = Astro.props;

// Every page title ends with the brand so search results read consistently.
const pageTitle = title.includes(SITE_NAME) ? title : `${title} | ${SITE_NAME}`;

const canonicalURL = Astro.site ? new URL(Astro.url.pathname, Astro.site) : Astro.url;
const socialImage = new URL(ogImage || '/images/social/mars-whole-planet.jpg', canonicalURL);

const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': `${canonicalURL.origin}/#website`,
      name: SITE_NAME,
      description: 'Explore where we could settle on Mars, how we could build there, and what it would take to make the planet habitable.',
      url: canonicalURL.origin,
      publisher: { '@id': `${canonicalURL.origin}/#organization` },
    },
    {
      '@type': 'Organization',
      '@id': `${canonicalURL.origin}/#organization`,
      name: SITE_NAME,
      url: canonicalURL.origin,
      email: SITE_EMAIL,
      logo: new URL('/apple-touch-icon.png', canonicalURL.origin).href,
    },
  ],
};
const footerLinks = [
  { href: '/about', label: 'About' },
  { href: '/contact', label: 'Contact' },
  { href: '/support', label: 'Support the research' },
  { href: '/pitch', label: 'Investors & grants' },
  { href: '/space-economy', label: 'Space economy directory' },
  { href: '/blog', label: 'Blog' },
  { href: '/privacy', label: 'Privacy' },
  { href: '/terms', label: 'Terms' },
];
---

<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    
    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-JDL6JCHFPH"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      gtag('config', 'G-JDL6JCHFPH');
    </script>
    
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=mars" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta name="generator" content={Astro.generator} />
    
    <!-- SEO -->
    <title>{pageTitle}</title>
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonicalURL} />
    
    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={socialImage} />
    {!ogImage && <meta property="og:image:width" content="1731" />}
    {!ogImage && <meta property="og:image:height" content="909" />}
    <meta property="og:site_name" content={SITE_NAME} />
    {!ogImage && <meta property="og:image:alt" content="Detailed illustration of the whole planet Mars against black space" />}
    
    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:title" content={pageTitle} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={socialImage} />
    {!ogImage && <meta property="twitter:image:alt" content="Detailed illustration of the whole planet Mars against black space" />}
    
    <!-- Structured Data -->
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />

    <!-- Preload critical resources (globe texture only where the globe renders) -->
    {preloadGlobeTexture && (
      <link rel="preload" href="/mars-data/5672_mars_6k_color.jpg" as="image" />
    )}
    
    <!-- Global CSS will be handled by Astro automatically -->
  </head>
  
  <body class={`min-h-screen bg-gwern-bg dark:bg-gwern-bg-dark text-gwern-text dark:text-gwern-text-dark ${className}`}>
    <!-- Skip to main content for accessibility -->
    <a href="#main-content" class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 bg-mars-red text-white px-4 py-2 rounded-md z-50">
      Skip to main content
    </a>
    
    <!-- Header -->
    <header class="sticky top-0 z-40 bg-gray-700 backdrop-blur-sm border-b border-gray-600">
      <nav class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex items-center justify-between h-16">
          <!-- Brand and population counter (replacing logo) -->
          <div class="flex items-center min-w-0 space-x-3 sm:space-x-4">
            <a href="/" class="text-white font-display text-base sm:text-lg font-bold whitespace-nowrap hover:text-mars-orange transition-colors">
              {SITE_NAME}
            </a>
            <div class="hidden xl:block text-gray-300 text-sm whitespace-nowrap" id="current-datetime">
              <!-- Date/time will be populated by client-side script -->
            </div>
            <div class="flex items-center space-x-1.5 sm:space-x-2 whitespace-nowrap">
              <span class="text-gray-400 text-xs sm:text-sm">Population:</span>
              <span class="text-mars-orange font-display text-base sm:text-lg font-bold">0</span>
            </div>
          </div>
          
          <!-- Desktop Navigation -->
          <div class="hidden lg:block">
            <div class="ml-8 flex items-baseline space-x-2">
              <a href="/orbit" class="nav-link-dark">Orbit</a>
              <a href="/construction" class="nav-link-dark">Infrastructure</a>
              <a
                href="/space-economy"
                class:list={['nav-link-dark', { 'nav-link-dark-active': Astro.url.pathname.startsWith('/space-economy') }]}
                aria-current={Astro.url.pathname.startsWith('/space-economy') ? 'page' : undefined}
              >Space Economy</a>
              <a
                href="/blog"
                class:list={['nav-link-dark', { 'nav-link-dark-active': Astro.url.pathname.startsWith('/blog') }]}
                aria-current={Astro.url.pathname.startsWith('/blog') ? 'page' : undefined}
              >Blog</a>
              <a href="/construction/sintering-bricks" class="nav-link-dark">Solar Paving</a>
              {showDonationCTA && (
                <a href="/support" class="btn-primary ml-6">
                  Support Research
                </a>
              )}
            </div>
          </div>
          
          <!-- Mobile menu button -->
          <div class="lg:hidden">
            <button 
              type="button" 
              class="btn-ghost p-2" 
              aria-controls="mobile-menu" 
              aria-expanded="false"
              id="mobile-menu-button"
            >
              <span class="sr-only">Open main menu</span>
              <svg class="block h-6 w-6" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
              </svg>
            </button>
          </div>
        </div>
        
        <!-- Mobile Navigation -->
        <div class="lg:hidden hidden" id="mobile-menu">
          <div class="px-2 pt-2 pb-3 space-y-1 sm:px-3 border-t border-gwern-border dark:border-gwern-border-dark">
            <a href="/orbit" class="block nav-link-dark">Orbit</a>
            <a href="/construction" class="block nav-link-dark">Infrastructure</a>
            <a
              href="/space-economy"
              class:list={['block nav-link-dark', { 'nav-link-dark-active': Astro.url.pathname.startsWith('/space-economy') }]}
              aria-current={Astro.url.pathname.startsWith('/space-economy') ? 'page' : undefined}
            >Space Economy</a>
            <a
              href="/blog"
              class:list={['block nav-link-dark', { 'nav-link-dark-active': Astro.url.pathname.startsWith('/blog') }]}
              aria-current={Astro.url.pathname.startsWith('/blog') ? 'page' : undefined}
            >Blog</a>
            <a href="/construction/sintering-bricks" class="block nav-link-dark">Solar Paving</a>
            {showDonationCTA && (
              <a href="/support" class="block btn-primary mt-4">
                Support Research
              </a>
            )}
          </div>
        </div>
      </nav>
    </header>
    
    <!-- Main Content -->
    <main id="main-content" class="flex-1">
      <slot />
    </main>
    
    <!-- Footer -->
    <footer class="bg-gray-50 dark:bg-gray-900 border-t border-gwern-border dark:border-gwern-border-dark">
      <div class="max-w-7xl mx-auto py-12 px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 md:grid-cols-4 gap-8">
          <!-- About -->
          <div class="col-span-1 md:col-span-2">
            <div class="flex items-center space-x-3 mb-4">
              <div class="w-8 h-8 bg-mars-gradient rounded-full flex items-center justify-center">
                <svg class="w-5 h-5 text-white" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
                  <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM4.332 8.027a6.012 6.012 0 011.912-2.706C6.512 5.73 6.974 6 7.5 6A1.5 1.5 0 019 7.5V8a2 2 0 004 0 2 2 0 011.523-1.943A5.977 5.977 0 0116 10c0 .34-.028.675-.083 1H15a2 2 0 00-2 2v2.197A5.973 5.973 0 0110 16v-2a2 2 0 00-2-2 2 2 0 01-2-2 2 2 0 00-1.668-1.973z" clip-rule="evenodd"></path>
                </svg>
              </div>
              <span class="font-display font-semibold text-lg">{SITE_NAME}</span>
            </div>
            <p class="text-gray-600 dark:text-gray-400 max-w-md mb-6">
              Independent research toward settling Mars: candidate landing sites, regolith construction, and the orbital operations a settlement depends on.
            </p>
            <div class="max-w-md">
              <NewsletterSignup source="footer" />
            </div>
          </div>

          <!-- Quick Links -->
          <div>
            <h2 class="font-display font-semibold text-gwern-text dark:text-gwern-text-dark mb-4">{SITE_NAME}</h2>
            <ul class="space-y-2">
              {footerLinks.map((link) => (
                <li><a href={link.href} class="text-gray-600 dark:text-gray-400 hover:text-mars-red dark:hover:text-mars-orange transition-colors">{link.label}</a></li>
              ))}
            </ul>
          </div>

          <!-- Contact -->
          <div>
            <h2 class="font-display font-semibold text-gwern-text dark:text-gwern-text-dark mb-4">Get in touch</h2>
            <ul class="space-y-2 text-gray-600 dark:text-gray-400">
              <li><a href="/contact#investors" class="hover:text-mars-red dark:hover:text-mars-orange transition-colors">Investors</a></li>
              <li><a href="/contact#press" class="hover:text-mars-red dark:hover:text-mars-orange transition-colors">Press</a></li>
              <li><a href="/contact#grants" class="hover:text-mars-red dark:hover:text-mars-orange transition-colors">Grants &amp; partners</a></li>
              <li><a href={`mailto:${SITE_EMAIL}`} class="break-all hover:text-mars-red dark:hover:text-mars-orange transition-colors">{SITE_EMAIL}</a></li>
            </ul>
          </div>
        </div>
        
        <div class="mt-8 pt-8 border-t border-gwern-border dark:border-gwern-border-dark">
          <p class="text-center text-gray-600 dark:text-gray-400 text-sm">
            © {new Date().getFullYear()} {SITE_NAME}. Built for the future of humanity.
          </p>
        </div>
      </div>
    </footer>
    
    <!-- Mobile menu toggle script -->
    <script>
      const mobileMenuButton = document.getElementById('mobile-menu-button');
      const mobileMenu = document.getElementById('mobile-menu');
      
      if (mobileMenuButton && mobileMenu) {
        mobileMenuButton.addEventListener('click', () => {
          const isExpanded = mobileMenuButton.getAttribute('aria-expanded') === 'true';
          mobileMenuButton.setAttribute('aria-expanded', (!isExpanded).toString());
          mobileMenu.classList.toggle('hidden');
        });
      }
    </script>
    
    <!-- DateTime update script -->
    <script>
      function updateDateTime() {
        const now = new Date();
        const options: Intl.DateTimeFormatOptions = {
          weekday: 'short',
          year: 'numeric',
          month: 'short',
          day: 'numeric',
          hour: '2-digit',
          minute: '2-digit',
          second: '2-digit',
          timeZone: 'UTC',
          timeZoneName: 'short',
        };

        const dateTimeElement = document.getElementById('current-datetime');
        if (dateTimeElement) {
          dateTimeElement.textContent = now.toLocaleString('en-US', options);
        }
      }

      // Update immediately and then every second
      updateDateTime();
      setInterval(updateDateTime, 1000);
    </script>
  </body>
</html>
